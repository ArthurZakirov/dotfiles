# Shared command-line dependencies for both profiles.
# Chezmoi is installed by its official bootstrap installer before this runs.
# Homebrew formulas without a CLI (shell plugins) are checked via brew list.
brew "chezmoi" # binary: chezmoi
brew "git" # binary: git
brew "fzf" # binary: fzf
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "python" # binary: python3; min-version: 3.11
brew "uv" # binary: uv

# Additional shared command-line tools (both profiles).
# The binary comment preserves the existing "command -v" installation check.
cask "codex" # binary: codex
cask "claude-code" # binary: claude
brew "node" # binary: node
brew "openclaw/tap/peekaboo" # binary: peekaboo
