#!/bin/bash
set -euo pipefail

# GUI tooling requires macOS; isolated CI exercises rendering without script hooks.
[[ "$(uname -s)" == Darwin ]] || exit 0

DOTFILES_ROOT={{ .chezmoi.workingTree | quote }}
# The before-hook's PATH changes do not persist into this process.
source "$DOTFILES_ROOT/src/homebrew.sh"
configure_homebrew
if ! command -v peekaboo >/dev/null 2>&1 || ! command -v npx >/dev/null 2>&1; then
  printf 'Peekaboo: CLI missing after application provisioning.\n' >&2
  exit 1
fi

if [ -r "$DOTFILES_ROOT/src/provisioning-log.sh" ]; then
  source "$DOTFILES_ROOT/src/provisioning-log.sh"
  dotfiles_section "AGENT TOOLING"
fi
source "$DOTFILES_ROOT/src/agent-skills.sh"
dotfiles_subsection "NPX SKILLS / PEEKABOO"
ensure_agent_skill peekaboo openclaw/Peekaboo
