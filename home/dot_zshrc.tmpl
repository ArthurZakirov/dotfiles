# Managed by chezmoi. Edit the source, then run chezmoi diff and chezmoi apply.
# PATHS
# ------------------------------------------------------
# Homebrew works on Apple Silicon and Intel Macs.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
typeset -U path
path=("$HOME/.local/bin" $path)
export ZSH="$HOME/.oh-my-zsh"
export REPOS_DIR="$HOME/Repos"
export PERSONAL_REPOS_DIR="$REPOS_DIR/personal"
export THIRD_PARTY_REPOS_DIR="$REPOS_DIR/third-party"
export PROFESSIONAL_REPOS_DIR="$REPOS_DIR/professional"
export TICKETS_DIR="$HOME/Tickets"

# ZSH CONFIGURATION
# ------------------------------------------------------
# One plugin manager for installation (Homebrew); Oh My Zsh loads Git helpers.
ZSH_THEME=""
plugins=(git)
zstyle ':omz:update' mode disabled
source "$ZSH/oh-my-zsh.sh"

# HISTORY
# ------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY

# SEARCH & COMPLETION
# ------------------------------------------------------
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# PROMPT
# ------------------------------------------------------
# Folder name and Git branch; add a hook without replacing other precmd hooks.
autoload -Uz vcs_info add-zsh-hook
add-zsh-hook precmd vcs_info
zstyle ':vcs_info:git:*' formats ' (%b)'
setopt PROMPT_SUBST
PROMPT='%1~${vcs_info_msg_0_} %# '

# CHEZMOI & EDITOR
# ------------------------------------------------------
export GITHUB_USERNAME={{ .githubUsername | quote }}
export CHEZMOI_SOURCE_PATH={{ .chezmoi.sourceDir | quote }}
export EDITOR="code --wait"
# WORKFLOW COMMANDS & ALIASES
# ------------------------------------------------------
alias sync-systemsmith="npx --yes skills add ArthurZakirov/SystemSmith --global --agent codex --skill '*' --yes"
alias sync-agents-md="curl -fsSL https://raw.githubusercontent.com/ArthurZakirov/AgentDesk/main/scripts/install-global-guidance.sh | sh"
# Optional integrations become available when AgentDesk/Raycast are installed.
raycast-quicklinks() {
  local script="$PERSONAL_REPOS_DIR/AgentDesk/scripts/generate_raycast_quicklinks.py"
  [[ -f "$script" ]] || script="$REPOS_DIR/.worktrees/AgentDesk-raycast-quicklinks/scripts/generate_raycast_quicklinks.py"
  [[ -f "$script" ]] || { print -u2 'Install the AgentDesk Raycast quicklinks script first.'; return 1; }
  python3 "$script" "$@"
}
[[ -f "$HOME/.local/bin/raycast_folder_quicklinks.py" ]] && alias sync-raycast-folder-quicklinks="python3 $HOME/.local/bin/raycast_folder_quicklinks.py"

{{ if eq .profile "personal" -}}
{{ template "personal.zsh" . }}
{{ end -}}
# LOCAL CONFIGURATION
# ------------------------------------------------------
# Optional untracked additions; machine differences belong in chezmoi templates.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
# PLUGIN LOADING
# ------------------------------------------------------
# Plugins load once, from the same package source on every Mac.
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
# Highlighting must load after completion and custom widgets.
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
