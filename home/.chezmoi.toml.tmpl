{{- $profile := promptChoiceOnce . "profile" "Mac profile" (list "personal" "professional") "personal" -}}
{{- $githubUsername := promptStringOnce . "githubUsername" "GitHub username" (env "GITHUB_USERNAME") -}}
{{- $account := "" -}}
{{- if eq $profile "personal" -}}
{{- $account = promptStringOnce . "bwsAccount" "Bitwarden Keychain account" (env "BWS_KEYCHAIN_ACCOUNT") -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}
    githubUsername = {{ $githubUsername | quote }}
    bwsAccount = {{ $account | quote }}

[diff]
    command = "/bin/bash"
    args = [{{ (printf "%s/home/dot_local/bin/executable_chezmoi-code-diff" .chezmoi.workingTree) | quote }}]
    exclude = ["scripts"]

[edit]
    command = "code"
    args = ["--wait"]
