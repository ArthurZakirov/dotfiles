{{- $profile := promptChoiceOnce . "profile" "Mac profile" (list "personal" "professional") "personal" -}}
{{- $reposDir := (env "REPOS_DIR" | default (printf "%s/Repos" .chezmoi.homeDir)) -}}
{{- $githubUsername := promptStringOnce . "githubUsername" "GitHub username" (env "GITHUB_USERNAME") -}}
{{- $account := "" -}}
{{- if eq $profile "personal" -}}
{{- $account = promptStringOnce . "bwsAccount" "Bitwarden Keychain account" (env "BWS_KEYCHAIN_ACCOUNT") -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}
    githubUsername = {{ $githubUsername | quote }}
    reposDir = {{ $reposDir | quote }}
    bwsAccount = {{ $account | quote }}

[diff]
    pager = ""
    command = "/bin/bash"
    args = [{{ (printf "%s/home/dot_local/bin/executable_chezmoi-code-diff" .chezmoi.workingTree) | quote }}, {{ .chezmoi.workingTree | quote }}]
    exclude = ["scripts"]

[edit]
    command = "code"
    args = ["--wait"]

{{ if eq .chezmoi.os "darwin" -}}
# Compare the live macOS shortcut configuration after normal file diffs.
[hooks.diff.post]
    command = "/usr/bin/env"
    args = ["python3", {{ (printf "%s/src/macos_shortcuts.py" .chezmoi.workingTree) | quote }}, "review", {{ (printf "%s/home/dot_config/macos-shortcuts/shortcuts.json" .chezmoi.workingTree) | quote }}]
{{ end -}}
