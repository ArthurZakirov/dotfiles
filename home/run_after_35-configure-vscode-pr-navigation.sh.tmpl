#!/bin/sh
# Merge shortcuts into the user's existing VS Code config without replacing
# unrelated settings or requiring the repository to own entire JSON files.
set -eu
if [ "{{ .chezmoi.os }}" != "darwin" ]; then exit 0; fi
exec /usr/bin/env python3 {{ (printf "%s/src/install_vscode_pr_navigation.py" .chezmoi.workingTree) | quote }} --install
