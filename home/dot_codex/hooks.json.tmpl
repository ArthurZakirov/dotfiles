{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/scope-checkpoint/checkpoint.py\" hook",
            "commandWindows": "py -3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/scope-checkpoint/checkpoint.py\" hook",
            "timeoutSec": 5,
            "async": false
          },
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/bedtime-device-guard/bedtime_guard.py\" --config \"{{ .chezmoi.homeDir }}/.codex/hooks-json/bedtime-device-guard/config.json\" --managed-by codex-bedtime-device-guard",
            "commandWindows": "py -3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/bedtime-device-guard/bedtime_guard.py\" --config \"{{ .chezmoi.homeDir }}/.codex/hooks-json/bedtime-device-guard/config.json\" --managed-by codex-bedtime-device-guard",
            "timeoutSec": 2,
            "async": false
          },
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/agents-md-freshness/check.py\"",
            "timeoutSec": 20,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/scope-checkpoint/checkpoint.py\" hook",
            "commandWindows": "py -3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/scope-checkpoint/checkpoint.py\" hook",
            "timeoutSec": 5,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.codex/hooks-json/agents-md-freshness/check.py\"",
            "timeoutSec": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
