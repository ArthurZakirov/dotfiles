#!/bin/bash
# Keep normal Codex separate; enable the opt-in speech behavior only here.
set -euo pipefail
export CODEX_REALTIME_VERBATIM_SPEECH=1
# Older releases safely ignore the new environment variable. The updated
# custom fork enables its AGENTS indicator when no explicit /statusline choice
# exists, without passing unsupported -c keys to previous binaries.
export PATH="$HOME/.local/bin:$PATH"
export CODEX_STATUS_LINE_COMMANDS='[{"label":"AGENTS","command":"codex-agents-status"}]'
# Keep the Voice session on this package's embedded server, rather than a
# separately installed shared daemon that may run a different build.
binary="$HOME/.local/share/codex-voice/bin/codex"
for arg in "$@"; do
  [[ "$arg" != -- ]] || break
  if [[ "$arg" == --no-daemon || "$arg" == --remote || "$arg" == --remote=* ]]; then
    exec "$binary" "$@"
  fi
done
exec "$binary" --no-daemon "$@"
