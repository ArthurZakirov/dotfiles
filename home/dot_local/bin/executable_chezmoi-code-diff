#!/bin/bash
set -euo pipefail

if [[ $# -ne 2 && $# -ne 3 ]]; then
  echo 'Usage: chezmoi-code-diff [WORKSPACE] ORIGINAL TARGET' >&2
  exit 2
fi
configured_workspace=""
if [[ $# -eq 3 ]]; then
  configured_workspace="$1"
  shift
fi
original="$1"
target="$2"

# A directory tree belongs in a textual recursive diff; VS Code's --diff
# expects two files. Symlinks (even dangling or directory-valued ones) must be
# handled as links rather than followed into an unrelated checkout.
if [[ ( -d "$original" && ! -L "$original" ) || ( -d "$target" && ! -L "$target" ) ]]; then
  if [[ "$original" == /dev/null || "$target" == /dev/null ]]; then
    temp_dir="$(mktemp -d)"
    trap 'rm -rf "$temp_dir"' EXIT
    mkdir -p "$temp_dir/empty-directory"
    [[ "$original" != /dev/null ]] || original="$temp_dir/empty-directory"
    [[ "$target" != /dev/null ]] || target="$temp_dir/empty-directory"
  fi
  diff -ruN "$original" "$target" || [[ $? -eq 1 ]]
  exit
fi

# Chezmoi's target files live in a temporary tree that disappears when
# chezmoi diff exits. The editor should remain readable long after the
# invocations have finished. Preserve BOTH documents independently.
# The private cache is pruned after 30 days on subsequent diff invocations.
umask 077
cache="${CHEZMOI_CODE_DIFF_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/chezmoi/vscode-diff}"
mkdir -p "$cache"
find "$cache" -mindepth 1 -maxdepth 1 -type d -name 'diff.*' -mtime +30 -exec rm -rf -- {} +
snapshot="$(mktemp -d "$cache/diff.XXXXXXXX")"

snapshot_file() {
  local from="$1" side="$2"
  local filename
  filename="${from##*/}"
  [[ "$from" != /dev/null ]] || filename="empty"
  local to="$snapshot/$side/$filename"
  mkdir -p "$snapshot/$side"
  if [[ "$from" == /dev/null ]]; then
    : > "$to"
  elif [[ -L "$from" ]]; then
    printf 'Symbolic link -> %s\n' "$(readlink "$from")" > "$to"
  elif [[ -f "$from" ]]; then
    cp -p "$from" "$to"
  else
    printf 'chezmoi-code-diff: unsupported input: %s\n' "$from" >&2
    return 1
  fi
  printf '%s\n' "$to"
}

# The Codex TOML is locally maintained, except for the versioned Live Voice
# prompt. Display that *one* projected edit as a readable Markdown diff rather
# than an enormous escaped TOML string. Never cache other local config values.
if [[ "$original" == */.codex/config.toml || ( "$original" == /dev/null && "${target##*/}" == config.toml ) ]]; then
  original_snapshot="$snapshot/before/realtime-voice-backend-prompt.md"
  target_snapshot="$snapshot/after/realtime-voice-backend-prompt.md"
  mkdir -p "$snapshot/before" "$snapshot/after"
  python3 - "$original" "$target" "$original_snapshot" "$target_snapshot" <<'PYTHON'
from pathlib import Path
import sys
import tomllib

before_path, after_path, before_md, after_md = sys.argv[1:]
def read(path: str) -> dict:
    return tomllib.loads(Path(path).read_text(encoding="utf-8")) if path != "/dev/null" else {}

before = read(before_path)
after = read(after_path)
key = "experimental_realtime_ws_backend_prompt"
if {k: v for k, v in before.items() if k != key} != {k: v for k, v in after.items() if k != key}:
    raise ValueError("Codex TOML diff contains changes outside the versioned Live Voice prompt")
for source, destination in ((before, before_md), (after, after_md)):
    value = source.get(key, "")
    if not isinstance(value, str):
        raise ValueError("Codex Live Voice prompt is not a string")
    Path(destination).write_text(value, encoding="utf-8")
PYTHON
else
  original_snapshot="$(snapshot_file "$original" before)"
  target_snapshot="$(snapshot_file "$target" after)"
fi
# Chezmoi calls this adapter separately for each changed file. Do NOT
# background `code --wait`: launching 20 independent Code/Electron processes
# concurrently silently drops diff tabs on an already-running macOS desktop.
# Each dispatch must finish before the next begins. A small settling interval
# also gives VS Code time to register the new tab before the next request.
# Both snapshots persist after this command exits.
#
# A desktop may have several VS Code windows. Always include the repository
# workspace so requests go to the right window rather than the last active one.
workspace="${CHEZMOI_CODE_DIFF_WORKSPACE:-${configured_workspace:-}}"
if [[ -z "$workspace" ]]; then
  source_dir="$(chezmoi source-path 2>/dev/null)" || source_dir="$PWD"
  [[ -d "$source_dir" ]] || source_dir="$PWD"
  # A chezmoi source tree often lives in <repo>/home, while VS Code has
  # <repo> open. Target that actual workspace, not a new `home` window.
  workspace="$(git -C "$source_dir" rev-parse --show-toplevel 2>/dev/null)" || workspace="$source_dir"
fi
if [[ ! -d "$workspace" ]]; then
  printf 'chezmoi-code-diff: VS Code workspace does not exist: %s\n' "$workspace" >&2
  exit 1
fi
if ! command -v code >/dev/null 2>&1; then
  # A clean Mac may not have VS Code installed yet. Diff must remain readable
  # before chezmoi apply provisions it; no silent omission or GUI dependency.
  printf 'chezmoi-code-diff: VS Code CLI missing; showing text diff instead.\n' >&2
  diff -u "$original_snapshot" "$target_snapshot" || [[ $? -eq 1 ]]
  exit
fi
code --reuse-window --diff "$original_snapshot" "$target_snapshot" "$workspace"
sleep "${CHEZMOI_CODE_DIFF_SETTLE_SECONDS:-1}"
