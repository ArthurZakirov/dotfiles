#!/usr/bin/env bash
# Mac-wide Backlog.md command; intentionally independent of the current Git repository.
set -euo pipefail
umask 077

root="${AGENT_BACKLOG_DIR:-$HOME/.local/share/agent-backlog}"
if ! command -v backlog >/dev/null 2>&1; then
  printf 'Backlog.md is missing. Install the shared Homebrew dependency (backlog-md).\n' >&2
  exit 127
fi

if [[ ! -f "$root/backlog/config.yml" && ! -f "$root/.backlog/config.yml" && ! -f "$root/backlog.config.yml" ]]; then
  mkdir -p "$root"
  (
    cd "$root"
    backlog init "Mac Agent Work" --defaults --no-git --integration-mode none \
      --task-prefix AGENT --web-port 6420 --auto-open-browser false
  ) >&2
fi

cd "$root"

# Codex supplies its *own* thread UUID to shell tools. Capture the successful
# result of a task write and attach a single resume command to each affected
# task. Do not guess IDs by searching history, and never link ChatGPT sessions.
if [[ $# -ge 2 && "$1" == "task" && ( "$2" == "create" || "$2" == "edit" ) ]]; then
  session_id="${CODEX_THREAD_ID:-}"
  if [[ "$session_id" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]; then
    capture=$(mktemp "${TMPDIR:-/tmp}/agent-backlog-session.XXXXXX")
    trap 'rm -f "$capture"' EXIT
    if backlog "$@" | tee "$capture"; then
      linker="$HOME/.local/bin/agent-backlog-codex-session"
      if [[ -f "$linker" ]]; then
        if ! /usr/bin/python3 "$linker" "$capture"; then
          printf 'agent-backlog: task saved, but Codex session linking failed; see warning above.\n' >&2
        fi
      else
        printf 'agent-backlog: task saved, but session linker is not installed.\n' >&2
      fi
      exit 0
    else
      exit $?
    fi
  fi
  if [[ -n "$session_id" ]]; then
    printf 'agent-backlog: ignoring malformed CODEX_THREAD_ID (task still runs).\n' >&2
  fi
fi

exec backlog "$@"
