#!/usr/bin/env python3
"""find-gpt-session: one CLI for Codex, ChatGPT Desktop and browser sessions."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from find_gpt_session.core import FindSessions, SearchRequest
from find_gpt_session.adapters import AVAILABLE, BrowserProvider, create_providers
from find_gpt_session.context import from_workspace, from_browser_url, ContextError
from find_gpt_session.launch import SessionOpener


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Find OpenAI conversations by Git artifact or remembered keywords.")
    selector = p.add_mutually_exclusive_group()
    selector.add_argument("--pr", help="GitHub/Bitbucket PR URL")
    selector.add_argument("--repo", help="Git repository name/path/remote")
    selector.add_argument("--branch", help="Git branch")
    selector.add_argument("--worktree", help="Git worktree path")
    selector.add_argument("--commit", help="Git commit SHA")
    selector.add_argument("--jira", help="Jira issue ID")
    selector.add_argument("--context-path", help="Find sessions for the active VS Code workspace")
    selector.add_argument("--context-url", help="Find sessions for the active GitHub/Bitbucket page")
    p.add_argument("words", nargs="*", help='Free text: search "worktree cleanup"')
    p.add_argument("--provider", action="append", choices=(*AVAILABLE, "all"),
                   help="Infrastructure source (repeatable). Default: codex + safari")
    p.add_argument("--limit", type=int, help="Maximum combined results (default: 8; --open: 25)")
    p.add_argument("--json", action="store_true", help="Machine-readable results")
    p.add_argument("--open", action="store_true",
                   help="Open all returned Codex sessions in Warp and ChatGPT sessions in Chrome")
    p.add_argument("--prepare-safari", action="store_true",
                   help="Prime the existing Safari ChatGPT search overlay for the next shortcut")
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.prepare_safari:
        selectors = ("pr", "repo", "branch", "worktree", "commit", "jira",
                     "context_path", "context_url")
        if args.words or args.open or args.provider or any(getattr(args, key) for key in selectors):
            parser().error("--prepare-safari cannot be combined with search/open selectors")
        warning = None
        try:
            ready = BrowserProvider("safari").prepare()
        except (OSError, RuntimeError, TimeoutError) as exc:
            ready = False
            warning = str(exc)[:250]
        if args.json:
            print(json.dumps({"prepared": ready, "warning": warning}))
        elif ready:
            print("Safari ChatGPT search is prepared.")
        else:
            print("Safari ChatGPT search could not be prepared.", file=sys.stderr)
        return 0 if ready else 2

    if args.limit is not None and args.limit < 1:
        parser().error("--limit must be positive")
    limit = args.limit if args.limit is not None else (25 if args.open else 8)
    selectors = [(name, getattr(args, name))
                 for name in ("pr", "repo", "branch", "worktree", "commit",
                              "jira", "context_path", "context_url")
                 if getattr(args, name)]
    if selectors and args.words:
        parser().error("Use either --pr/--branch/... or search KEYWORDS")
    if selectors:
        kind, raw = selectors[0]
    elif args.words:
        kind, raw = "text", " ".join(args.words[1:] if args.words[0] == "search" else args.words)
    else:
        parser().error("Provide --pr/--repo/--branch/--jira or search KEYWORDS")
    try:
        if kind == "context_path":
            request = from_workspace(raw)
        elif kind == "context_url":
            request = from_browser_url(raw)
        else:
            request = SearchRequest.create(kind, raw)
    except (ValueError, ContextError) as exc:
        parser().error(str(exc))
    names = args.provider or ["codex", "safari"]
    response = FindSessions(create_providers(names)).search(request, limit)
    opening = SessionOpener().open(response.hits) if args.open and response.hits else None
    if args.json:
        output = response.asdict()
        if opening is not None:
            output["opening"] = opening.asdict()
        print(json.dumps(output, ensure_ascii=False, indent=2))
    else:
        if not response.hits and response.incomplete_providers:
            print("Search incomplete: no verified sessions returned; matching chats may exist.")
        else:
            print(f"Found {len(response.hits)} sessions via {', '.join(response.providers)}")
        for hit in response.hits:
            print(f"  [{hit.provider}] {hit.title}")
            print(f"    {hit.url or hit.resume_command or '(no verified link)'}")
            print(f"    Evidence: {hit.evidence}")
        for warning in response.warnings:
            print(f"Warning: {warning}", file=sys.stderr)
        if response.incomplete_providers:
            print("Partial coverage: " + ", ".join(response.incomplete_providers), file=sys.stderr)
        if opening:
            print(f"Requested {len(opening.dispatched)} new Warp/Chrome tabs.")
            for issue in opening.skipped + opening.errors:
                print(f"Open warning: {issue}", file=sys.stderr)
    if opening is not None and (opening.errors or not opening.dispatched):
        return 2
    return 0 if response.hits else 2 if response.incomplete_providers else 1


if __name__ == "__main__":
    raise SystemExit(main())
