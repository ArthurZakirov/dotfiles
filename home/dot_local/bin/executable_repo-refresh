#!/usr/bin/env python3
"""Refresh permanent checkouts and rebase local branches with recovery worktrees."""

import argparse
import hashlib
from concurrent.futures import ThreadPoolExecutor, as_completed
import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid


class RefreshError(Exception):
    """An actionable failure without potentially credential-bearing Git output."""


def git(repo, *args, check=True):
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "GCM_INTERACTIVE": "never",
           "GIT_SSH_COMMAND": "ssh -oBatchMode=yes -oConnectTimeout=15", "LC_ALL": "C"}
    # Do not inherit a caller's repository/index routing into other checkouts.
    for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR",
                 "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
        env.pop(name, None)
    with subprocess.Popen(
            ["git", "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "submodule.recurse=false",
             "-c", "maintenance.auto=false", "-C", str(repo), *map(str, args)],
            env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True,
    ) as process:
        try:
            stdout, stderr = process.communicate(input=b"", timeout=120)
        except subprocess.TimeoutExpired:
            # Git may spawn SSH, credential helpers, or submodule children. Stop
            # the entire group before releasing the updater's repository lock.
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
            raise RefreshError(f"Git {args[0]} timed out; retry next cycle") from None
        result = subprocess.CompletedProcess(process.args, process.returncode, stdout, stderr)
    if check and result.returncode:
        raise RefreshError(f"Git {args[0]} failed (exit {result.returncode}); original or recovery worktree retained")
    return result


def value(repo, *args):
    return os.fsdecode(git(repo, *args).stdout).strip()


def git_path(repo, name):
    return Path(value(repo, "rev-parse", "--path-format=absolute", "--git-path", name))


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    with temporary.open("x") as stream:
        os.chmod(temporary, 0o600)
        json.dump(payload, stream, indent=2)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def repositories(root):
    """Manage only direct clones; ignore nested experiments and worktree siblings."""
    for repo in sorted(root.iterdir()):
        # Only immediate Git clones are managed; nested experiments and linked
        # worktrees are not permanent default-branch checkouts.
        if repo.is_dir() and not repo.is_symlink() and (repo / ".git").is_dir():
            yield repo


def inventory(repo, excluded_directories=()):
    """Detect changes to preserved files, including ignored non-cache data."""
    result = {}
    for current, directories, files in os.walk(repo, followlinks=False):
        if Path(current) == repo:
            directories[:] = [name for name in directories
                              if name != ".git" and name not in excluded_directories]
            files = [name for name in files if name != ".git"]
        for name in directories + files:
            path = Path(current) / name
            info = path.lstat()
            if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)
                    or stat.S_ISLNK(info.st_mode)):
                raise RefreshError("Special filesystem entry cannot be preserved; checkout left untouched")
            result[str(path.relative_to(repo))] = (
                info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns,
            )
    return result


OPERATION_STATE = (
    "rebase-merge", "rebase-apply", "sequencer", "MERGE_HEAD", "MERGE_MSG",
    "MERGE_MODE", "AUTO_MERGE", "CHERRY_PICK_HEAD", "REVERT_HEAD", "REBASE_HEAD",
    "ORIG_HEAD", "BISECT_LOG", "BISECT_START", "BISECT_NAMES", "BISECT_EXPECTED_REV",
)
ACTIVE_OPERATION_STATE = (
    "rebase-merge", "rebase-apply", "sequencer", "MERGE_HEAD",
    "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_START",
)


def copy_entry(source, destination):
    if sys.platform == "darwin":
        # cp -pR preserves symlinks, extended attributes, ACLs and resource forks.
        result = subprocess.run(["cp", "-pR", str(source), str(destination)],
                                capture_output=True, check=False)
        if result.returncode:
            raise RefreshError("Could not preserve macOS file metadata; original retained")
    elif source.is_dir() and not source.is_symlink():
        shutil.copytree(source, destination, symlinks=True)
    else:
        shutil.copy2(source, destination, follow_symlinks=False)


def preserve(repo, destination, branch, head, original_head, default, target):
    if not os.path.samefile(value(repo, "rev-parse", "--show-toplevel"), repo):
        raise RefreshError("Working tree redirects outside its selected path; left untouched")
    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Recovery may include ignored local credentials. Keep the entire hierarchy private.
    os.chmod(destination.parent, 0o700)
    # Preserve all untracked data except well-known rebuildable dependencies
    # and build output, and only when Git confirms the directory is ignored.
    excluded_caches = set()
    for name in ("node_modules", ".next", "out"):
        directory = repo / name
        if (directory.is_dir() and not directory.is_symlink()
                and git(repo, "check-ignore", "-q", "--", name, check=False).returncode == 0
                and not git(repo, "ls-files", "--", name).stdout):
            excluded_caches.add(name)
    before = inventory(repo, excluded_caches)
    estimated_bytes = sum(size for _, size, _, _ in before.values())
    free_bytes = shutil.disk_usage(destination.parent).free
    if free_bytes < estimated_bytes + 2 * 1024**3:
        raise RefreshError("Insufficient free space for a recovery; no new worktree created")
    original_index = git_path(repo, "index")
    index_bytes = original_index.read_bytes() if original_index.exists() else None
    recovery_ref = f"refs/repo-refresh/{destination.name}"
    git(repo, "update-ref", recovery_ref, head)
    git(repo, "worktree", "add", "--detach", "--no-checkout", destination, head)
    if not os.path.samefile(value(destination, "rev-parse", "--show-toplevel"), destination):
        raise RefreshError("Recovery Git directory resolves outside its worktree; original left untouched")
    os.chmod(destination, 0o700)
    record_dir = git_path(destination, "repo-refresh")
    record_dir.mkdir(mode=0o700)
    record = {"source": str(repo), "branch": branch, "head": original_head,
              "recovery_head": head,
              "default_branch": default, "target": target,
              "recovery_ref": recovery_ref, "complete": False}
    write_json(record_dir / "recovery.json", record)
    for entry in repo.iterdir():
        if entry.name != ".git" and entry.name not in excluded_caches:
            copy_entry(entry, destination / entry.name)

    # Submodules use gitfiles pointing back into the original checkout. Give their
    # recovery copies independent metadata, so recovery commands cannot alter originals.
    for current, directories, files in os.walk(destination, followlinks=False):
        directories[:] = [name for name in directories if name != ".git"]
        nested = Path(current)
        if nested != destination and ".git" in files:
            original = repo / nested.relative_to(destination)
            metadata = Path(value(original, "rev-parse", "--absolute-git-dir"))
            if (metadata / "commondir").exists():
                raise RefreshError("Nested linked worktree needs manual recovery; original left untouched")
            (nested / ".git").unlink()
            shutil.copytree(metadata, nested / ".git", symlinks=True)
            git(destination, "config", "--file", nested / ".git/config",
                "--unset-all", "core.worktree", check=False)

    if index_bytes is not None:
        git_path(destination, "index").write_bytes(index_bytes)
    # A split index references sharedindex files beside the original index.
    for shared in original_index.parent.glob("sharedindex.*"):
        shutil.copy2(shared, git_path(destination, "index").parent / shared.name)
    for name in OPERATION_STATE:
        source = git_path(repo, name)
        if source.exists():
            copy_entry(source, record_dir / name)
    current_head = git(repo, "rev-parse", "--verify", "HEAD", check=False)
    observed_head = os.fsdecode(current_head.stdout).strip() if current_head.returncode == 0 else None
    if (before != inventory(repo, excluded_caches) or observed_head != original_head
            or (original_index.read_bytes() if original_index.exists() else None) != index_bytes):
        raise RefreshError("Checkout changed during preservation; original left untouched; retry next cycle")
    default_ref = f"refs/heads/{default}"
    old_default = git(repo, "rev-parse", "--verify", default_ref, check=False)
    if old_default.returncode == 0:
        old_tip = os.fsdecode(old_default.stdout).strip()
        git(repo, "update-ref", recovery_ref + "-default", old_tip)
        record["previous_default"] = old_tip
    record["complete"] = True
    write_json(record_dir / "recovery.json", record)
    return record_dir


def worktree_path(repo, branch, recovery=False):
    # A worktree's folder must identify the branch or detached commit it contains.
    slug = "".join(char if char.isalnum() or char in "._-" else "-" for char in branch)
    slug = slug.strip(".-_")
    if not slug:
        # Preserve the identity of valid branches consisting only of symbols.
        slug = "branch-" + "-".join(f"u{ord(char):x}" for char in branch)
    if len(slug.encode("utf-8")) > 120:
        # Keep long names within filesystem component limits without ambiguity.
        while len(slug.encode("utf-8")) > 100:
            slug = slug[:-1]
        slug = f"{slug.rstrip('.-_')}-{hashlib.sha256(branch.encode()).hexdigest()[:10]}"
    parent = repo.with_name(f"{repo.name}.worktrees")
    if parent.is_symlink() or not os.path.samefile(parent.resolve().parent, repo.parent):
        raise RefreshError("Worktree directory redirects outside the repository's parent; checkout left untouched")
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(parent, 0o700)
    if recovery:
        slug = f"recovery-{slug}"
    destination = parent / slug
    if recovery or destination.exists() or destination.is_symlink():
        # Distinguish historical snapshots and slug collisions while retaining the branch name.
        suffix = time.strftime("%Y-%m-%d--%H-%M-%S") + "-" + uuid.uuid4().hex[:12]
        destination = parent / f"{slug}-{suffix}"
    return destination


def ensure_default_tracking(repo, remote, default):
    tracking = git(repo, "branch", "--set-upstream-to", f"{remote}/{default}",
                   default, check=False)
    if tracking.returncode:
        # Narrow-clone refspecs may not permit upstream tracking yet.
        git(repo, "config", "--add", f"remote.{remote}.fetch",
            f"+refs/heads/{default}:refs/remotes/{remote}/{default}")
        git(repo, "branch", "--set-upstream-to", f"{remote}/{default}", default)


def clean_fast_forward(repo, branch, default, head, target, dirty, operation, remote):
    """Update a clean default checkout without creating an unnecessary recovery."""
    if (branch != default or dirty or operation or head == target
            or git(repo, "merge-base", "--is-ancestor", head, target,
                   check=False).returncode != 0):
        return False
    # The force-replacement path handles sparse clones and submodule state.
    if (git(repo, "config", "--bool", "core.sparseCheckout",
            check=False).stdout.strip() == b"true"
            or (repo / ".gitmodules").exists()
            or git(repo, "ls-tree", "--name-only", target, "--", ".gitmodules").stdout):
        return False
    # An incoming tracked file can replace an existing ignored file. Keep the
    # full recovery path when that collision is possible.
    additions = git(repo, "diff", "--no-renames", "--diff-filter=A",
                    "--name-only", "-z", head, target).stdout
    for name in additions.split(b"\0"):
        if name:
            existing = repo / os.fsdecode(name)
            if existing.exists() or existing.is_symlink():
                return False
    git(repo, "merge", "--ff-only", target)
    ensure_default_tracking(repo, remote, default)
    if (value(repo, "symbolic-ref", "--short", "HEAD") != default
            or value(repo, "rev-parse", "HEAD") != target
            or git(repo, "status", "--porcelain=v1").stdout):
        raise RefreshError("Fast-forward checkout verification failed")
    return True


def refresh(repo, remote):
    # Fetch and resolve the remote's actual default before disturbing local files.
    git(repo, "fetch", "--prune", "--no-recurse-submodules", remote)
    advertised = value(repo, "ls-remote", "--symref", remote, "HEAD")
    default = next((line.split()[1][len("refs/heads/"):]
                    for line in advertised.splitlines()
                    if line.startswith("ref: refs/heads/") and line.endswith("\tHEAD")), None)
    if not default:
        raise RefreshError("Remote has no resolvable default branch; checkout left untouched")
    git(repo, "check-ref-format", f"refs/heads/{default}")
    # Fetch explicitly as narrow clone refspecs may exclude the default branch.
    git(repo, "fetch", "--no-recurse-submodules", remote,
        f"+refs/heads/{default}:refs/remotes/{remote}/{default}")
    git(repo, "remote", "set-head", remote, default)
    target = value(repo, "rev-parse", f"refs/remotes/{remote}/{default}")
    current_head = git(repo, "rev-parse", "--verify", "HEAD", check=False)
    original_head = os.fsdecode(current_head.stdout).strip() if current_head.returncode == 0 else None
    head = original_head
    if head is None:
        # An initialized but uncommitted checkout needs an empty recovery baseline.
        tree = value(repo, "hash-object", "-t", "tree", "--stdin", "-w")
        head = value(repo, "-c", "user.name=repo-refresh", "-c",
                     "user.email=repo-refresh@localhost", "commit-tree", tree,
                     "-m", "Recovery baseline for an unborn checkout")
    symbolic = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    branch = os.fsdecode(symbolic.stdout).strip() or None
    dirty = bool(git(repo, "status", "--porcelain=v1", "--untracked-files=all").stdout)
    operation = any(git_path(repo, name).exists() for name in ACTIVE_OPERATION_STATE)
    if branch == default and head == target and not dirty and not operation:
        return {"state": "current", "branch": default, "commit": target}
    if original_head and clean_fast_forward(
        repo, branch, default, original_head, target, dirty, operation, remote
    ):
        return {"state": "updated", "branch": default, "commit": target,
                "method": "fast-forward"}

    label = branch or f"detached-{head[:12]}"
    destination = worktree_path(repo, label, recovery=branch in (None, default))
    preserve(repo, destination, branch, head, original_head, default, target)
    try:
        released = restore_default(repo, destination, branch, head, default, target, remote)
    except (RefreshError, OSError) as error:
        message = str(error) if isinstance(error, RefreshError) else type(error).__name__
        raise RefreshError(f"{message}; recovery: {destination}") from None
    return {"state": "updated", "branch": default, "commit": target,
            "recovery": str(destination), "removed_main_worktrees": released}


def remove_displaced_default_worktrees(repo, default):
    """Remove only linked worktrees that currently own the default branch."""
    common = Path(value(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    worktree_data = git(repo, "worktree", "list", "--porcelain", "-z").stdout
    other = None
    removed = []
    for field in worktree_data.split(b"\0"):
        if field.startswith(b"worktree "):
            other = Path(os.fsdecode(field[len(b"worktree "):]))
        elif field == os.fsencode(f"branch refs/heads/{default}"):
            if other is None or other.is_symlink() or not other.is_dir():
                raise RefreshError("Default branch worktree path cannot be verified; left untouched")
            if os.path.samefile(other, repo):
                continue
            if (not os.path.samefile(value(other, "rev-parse", "--show-toplevel"), other)
                    or not os.path.samefile(value(other, "rev-parse", "--path-format=absolute",
                                             "--git-common-dir"), common)
                    or value(other, "symbolic-ref", "--short", "HEAD") != default):
                raise RefreshError("Default branch worktree cannot be verified; left untouched")
            # Two --force flags also permit removing a locked worktree. This
            # intentionally discards files only in the misplaced main checkout.
            git(repo, "worktree", "remove", "--force", "--force", other)
            removed.append(str(other))
    return removed


def restore_default(repo, destination, branch, head, default, target, remote):
    # All destructive steps occur only after the verified recovery record is durable.
    removed = remove_displaced_default_worktrees(repo, default)
    # Detach without checkout: dirty/conflicted indexes must not prevent preservation.
    git(repo, "update-ref", "--no-deref", "HEAD", head)
    if branch and branch != default:
        if git(repo, "show-ref", "--verify", f"refs/heads/{branch}", check=False).returncode:
            git(repo, "update-ref", f"refs/heads/{branch}", head)
        git(destination, "symbolic-ref", "HEAD", f"refs/heads/{branch}")
    for name in OPERATION_STATE:
        path = git_path(repo, name)
        if path.is_dir():
            shutil.rmtree(path)
        elif path.exists():
            path.unlink()
    git(repo, "-c", "core.sparseCheckout=false", "reset", "--hard", target)
    if git(repo, "config", "--bool", "core.sparseCheckout", check=False).stdout.strip() == b"true":
        git(repo, "sparse-checkout", "disable")
    # Includes nested untracked repos; every file was copied above. Ignored files
    # remain in place where possible and have also been copied to recovery.
    git(repo, "clean", "-ffd")
    git(repo, "checkout", "--force", "-B", default, target)
    ensure_default_tracking(repo, remote, default)
    if (repo / ".gitmodules").is_file():
        git(repo, "submodule", "sync", "--recursive")
        git(repo, "submodule", "update", "--init", "--recursive", "--force")
        git(repo, "submodule", "foreach", "--recursive", "git reset --hard && git clean -ffd")
    if (value(repo, "symbolic-ref", "--short", "HEAD") != default
            or value(repo, "rev-parse", "HEAD") != target
            or git(repo, "status", "--porcelain=v1").stdout):
        raise RefreshError(f"Checkout verification failed; recovery: {destination}")
    return removed


def branch_worktrees(repo):
    """Associate detached, unfinished rebases with the branch they are replaying."""
    paths = {}
    current = None
    for field in git(repo, "worktree", "list", "--porcelain", "-z").stdout.split(b"\0"):
        if field.startswith(b"worktree "):
            current = Path(os.fsdecode(field[len(b"worktree "):]))
            if not current.is_dir():
                current = None
                continue
            for state in ("rebase-merge", "rebase-apply"):
                try:
                    head_name = git_path(current, f"{state}/head-name")
                except RefreshError:
                    # Preserve unreadable or orphaned worktrees without aborting
                    # maintenance of unrelated branches in this repository.
                    current = None
                    break
                if head_name.is_file():
                    branch = head_name.read_text().strip().removeprefix("refs/heads/")
                    paths.setdefault(branch, set()).add(current)
        elif field.startswith(b"branch refs/heads/") and current is not None:
            branch = os.fsdecode(field[len(b"branch refs/heads/"):])
            paths.setdefault(branch, set()).add(current)
    return paths


def rebase_branch(repo, branch, candidates, default, target):
    if len(candidates) > 1:
        raise RefreshError("Branch is checked out in multiple worktrees; cannot safely choose one")
    source = next(iter(candidates), None)
    previous = {}
    if source is not None:
        marker = git_path(source, "repo-refresh-rebase.json")
        if marker.is_file():
            previous = json.loads(marker.read_text())
            if not isinstance(previous, dict):
                raise RefreshError("Invalid rebase recovery record; inspect the worktree metadata")
            if previous.get("branch") != branch:
                previous = {}
        unmerged = bool(git(source, "ls-files", "--unmerged").stdout)
        active = any(git_path(source, name).exists() for name in ACTIVE_OPERATION_STATE)
        if active or unmerged:
            return {**previous, "state": "conflicts" if unmerged else "in-progress", "worktree": str(source)}
        # Failed rebases require manual resolution. Retrying every minute
        # would create another full recovery worktree without fixing the cause.
        if previous.get("state") in {"edits-pending", "failed"}:
            return previous
    if git(repo, "merge-base", "--is-ancestor", target, f"refs/heads/{branch}", check=False).returncode == 0:
        return {"state": "current", **({"worktree": str(source)} if source else {})}
    if source is None:
        source = worktree_path(repo, branch)
        git(repo, "worktree", "add", source, branch)
    head = value(source, "rev-parse", "HEAD")
    recovery = worktree_path(repo, branch, recovery=True)
    preserve(source, recovery, branch, head, head, default, target)
    if value(source, "symbolic-ref", "--short", "HEAD") != branch:
        raise RefreshError(f"Branch changed during preservation; recovery: {recovery}")
    marker = git_path(source, "repo-refresh-rebase.json")
    record = {"branch": branch, "base": target, "original_head": head,
              "recovery": str(recovery), "worktree": str(source), "state": "running"}
    write_json(marker, record)
    previous_stash = git(source, "rev-parse", "--verify", "refs/stash", check=False).stdout.strip()
    # Native autostash restores tracked edits; an independent recovery worktree
    # retains index state, untracked/ignored content and the pre-rebase commit.
    # Never let rebase.updateRefs rewrite other branches without their own backups.
    result = git(source, "-c", "stash.index=true", "-c", "rebase.updateRefs=false",
                 "-c", "core.editor=true", "rebase", "--autostash", "--rebase-merges",
                 "--no-autosquash", target, check=False)
    unmerged = bool(git(source, "ls-files", "--unmerged").stdout)
    active = any(git_path(source, name).exists() for name in ("rebase-merge", "rebase-apply"))
    current_stash = git(source, "rev-parse", "--verify", "refs/stash", check=False).stdout.strip()
    edits_pending = False
    if current_stash and current_stash != previous_stash and "autostash" in value(
        source, "reflog", "show", "--max-count=1", "--format=%gs", "refs/stash",
    ):
        record["edits_stash"] = os.fsdecode(current_stash)
        git(source, "update-ref", f"refs/repo-refresh/{recovery.name}-edits", record["edits_stash"])
        # --index can refuse to apply a staged patch without leaving conflict
        # markers, even when rebase exits zero. Retry the merge without index
        # restoration only when Git left an entirely clean working tree.
        if not active and not unmerged:
            edits_pending = True
            if not git(source, "status", "--porcelain=v1").stdout:
                restored = git(source, "-c", "stash.index=false", "stash", "apply",
                               record["edits_stash"], check=False)
                unmerged = bool(git(source, "ls-files", "--unmerged").stdout)
                edits_pending = restored.returncode != 0 and not unmerged
    if unmerged:
        record["state"] = "conflicts"
    elif active:
        record["state"] = "in-progress"
    elif edits_pending:
        record["state"] = "edits-pending"
    elif result.returncode:
        record["state"] = "edits-pending" if git(
            source, "merge-base", "--is-ancestor", target, "HEAD", check=False,
        ).returncode == 0 else "failed"
    else:
        record["state"] = "rebased"
        record["commit"] = value(source, "rev-parse", "HEAD")
    write_json(marker, record)
    return record


def merged_evidence(repo, branch, target):
    """Prove inclusion by ancestry or an exact squash commit, using Git only."""
    tip = value(repo, "rev-parse", f"refs/heads/{branch}")
    if git(repo, "merge-base", "--is-ancestor", tip, target, check=False).returncode == 0:
        return "ancestor"
    merged = git(repo, "merge-base", "--all", tip, target, check=False)
    if merged.returncode:
        return None
    bases = os.fsdecode(merged.stdout).splitlines()
    if len(bases) != 1 or bases[0] == target:
        return None
    base = bases[0]
    changes = git(repo, "diff", "--raw", "--no-renames", "--no-abbrev", "-z",
                  base, tip).stdout
    if not changes:
        return None
    paths = git(repo, "diff", "--name-only", "--no-renames", "-z", base, tip).stdout
    names = [os.fsdecode(name) for name in paths.split(b"\0") if name]
    # Restrict history to first-parent commits that touch the branch's files.
    # A squash usually creates one such commit. A matching message is not proof.
    candidates = value(repo, "log", "--first-parent", "--max-count=300",
                       "--format=%H", f"{base}..{target}", "--", *names)
    for commit in candidates.splitlines():
        parent = value(repo, "rev-parse", f"{commit}^1")
        actual = git(repo, "diff", "--raw", "--no-renames", "--no-abbrev",
                     "-z", parent, commit).stdout
        if changes == actual:
            return f"squash:{commit[:12]}"
    return None


def safe_merged_worktree(repo, worktree):
    """Protect every local change except confirmed ignored build caches."""
    parent = repo.with_name(repo.name + ".worktrees")
    if (not parent.is_dir() or parent.is_symlink() or not worktree.parent.is_dir()
            or not os.path.samefile(worktree.parent, parent)
            or worktree.is_symlink() or not worktree.is_dir()):
        return False
    if not os.path.samefile(value(worktree, "rev-parse", "--show-toplevel"), worktree):
        return False
    if any(git_path(worktree, name).exists() for name in ACTIVE_OPERATION_STATE):
        return False
    if git(worktree, "ls-files", "--unmerged").stdout:
        return False
    status = git(worktree, "status", "--porcelain=v1", "-z",
                 "--untracked-files=all", "--ignored=matching").stdout
    allowed_caches = {"node_modules", ".next", "out"}
    for entry in status.split(b"\0"):
        if not entry:
            continue
        if not entry.startswith(b"!! "):
            return False
        relative = os.fsdecode(entry[3:]).rstrip("/")
        path = worktree / relative
        if (relative not in allowed_caches or not path.is_dir() or path.is_symlink()
                or git(worktree, "check-ignore", "-q", "--", relative,
                       check=False).returncode != 0
                or git(worktree, "ls-files", "--", relative).stdout):
            return False
    return True


def clean_merged_branch(repo, branch, candidates, remote, default, target):
    # An untouched branch is not merged work merely because main contains its
    # initial commit. Rebasing an empty branch also must not make it deletable.
    log = git(repo, "reflog", "show", "--format=%gs", f"refs/heads/{branch}", check=False)
    if (log.returncode or not any(entry.startswith((b"commit:", b"commit (", b"merge "))
                                  for entry in log.stdout.splitlines())):
        return None
    proof = merged_evidence(repo, branch, target)
    if not proof:
        return None
    if len(candidates) > 1:
        return {"state": "merged-protected", "reason": "Multiple branch worktrees",
                "proof": proof}
    source = next(iter(candidates), None)
    if source is not None and not safe_merged_worktree(repo, source):
        return {"state": "merged-protected", "reason": "Uncommitted or protected files",
                "worktree": str(source), "proof": proof}
    original = value(repo, "rev-parse", f"refs/heads/{branch}")
    # A changed default or branch tip invalidates our earlier proof.
    if (value(repo, "rev-parse", f"refs/remotes/{remote}/{default}") != target
            or value(repo, "rev-parse", f"refs/heads/{branch}") != original):
        return {"state": "merged-protected", "reason": "Refs changed during verification"}
    remote_state = "absent"
    remote_ref = f"refs/remotes/{remote}/{branch}"
    if git(repo, "show-ref", "--verify", remote_ref, check=False).returncode == 0:
        remote_tip = value(repo, "rev-parse", remote_ref)
        # Only delete a corresponding remote branch if the fetched tip matches
        # the local tip; a different remote history may contain additional work.
        if remote_tip != original:
            remote_state = "different-tip-preserved"
        else:
            advertised = value(repo, "ls-remote", "--heads", remote, f"refs/heads/{branch}")
            if advertised.split()[:1] != [remote_tip]:
                remote_state = "changed-preserved"
            else:
                result = git(repo, "push", f"--force-with-lease=refs/heads/{branch}:{remote_tip}",
                             remote, f":refs/heads/{branch}", check=False)
                remote_state = "deleted" if result.returncode == 0 else "deletion-rejected"
    if source is not None:
        git(repo, "worktree", "remove", "--force", source)
    # Squash-merged tips are not ancestors; -D is safe only after proof above.
    git(repo, "branch", "-D", branch)
    return {"state": "merged-cleaned", "proof": proof,
            "remote": remote_state, **({"worktree_removed": str(source)} if source else {})}


def rebase_branches(repo, default, target, remote):
    paths = branch_worktrees(repo)
    outcomes = []
    for reference in value(repo, "for-each-ref", "--format=%(refname)", "refs/heads/").splitlines():
        branch = reference.removeprefix("refs/heads/")
        if branch in {default, "main", "master"}:
            continue
        try:
            outcome = clean_merged_branch(repo, branch, paths.get(branch, set()),
                                          remote, default, target)
            if outcome is None:
                outcome = rebase_branch(repo, branch, paths.get(branch, set()),
                                        default, target)
        except (RefreshError, OSError, shutil.Error, ValueError) as error:
            message = str(error) if isinstance(error, RefreshError) else type(error).__name__
            outcome = {"state": "failed", "error": message}
        outcomes.append({"branch": branch, **outcome})
    return outcomes


def repair_permanent_checkout_path(repo):
    """Make a direct clone independent of a stale absolute core.worktree path."""
    selected_tree = Path(value(repo, "rev-parse", "--show-toplevel"))
    if selected_tree.exists() and os.path.samefile(selected_tree, repo):
        return False
    git_dir = repo / ".git"
    if (git_dir.is_symlink() or not git_dir.is_dir()
            or not os.path.samefile(value(repo, "rev-parse", "--absolute-git-dir"), git_dir)):
        raise RefreshError("Repository Git directory does not belong to selected checkout; left untouched")
    # Relative to .git/config, .. is the permanent checkout, on either Mac.
    git(repo, "config", "--local", "--replace-all", "core.worktree", "..")
    if not os.path.samefile(value(repo, "rev-parse", "--show-toplevel"), repo):
        raise RefreshError("Repository working-tree redirect could not be repaired; left untouched")
    return True


def copy_snapshot(source, destination):
    """Copy all worktree data, including ignored files, ACLs and macOS xattrs."""
    if sys.platform == "darwin":
        result = subprocess.run(["cp", "-pR", str(source), str(destination)],
                                capture_output=True, check=False)
        if result.returncode:
            raise RefreshError("Archival copy failed; registered worktrees retained")
    else:
        shutil.copytree(source, destination, symlinks=True)


def snapshot_fingerprint(root, skip_gitfile=False):
    """Check files, symlinks, file types, modes, ownership and extended attributes."""
    entries = {}
    for current, directories, files in os.walk(root, followlinks=False):
        for name in sorted(directories + files):
            path = Path(current) / name
            rel = path.relative_to(root).as_posix()
            if skip_gitfile and rel == ".git":
                continue
            info = path.lstat()
            record = {"mode": stat.S_IMODE(info.st_mode),
                      "type": stat.S_IFMT(info.st_mode),
                      "owner": info.st_uid, "group": info.st_gid}
            if stat.S_ISLNK(info.st_mode):
                record["link"] = os.readlink(path)
            elif stat.S_ISREG(info.st_mode):
                digest = hashlib.sha256()
                with path.open("rb") as stream:
                    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                        digest.update(chunk)
                record["content"] = digest.hexdigest()
            elif not stat.S_ISDIR(info.st_mode):
                raise RefreshError("Unsupported recovery file type; original retained")
            # macOS Python has no os.listxattr API; cp -pR preserves
            # resource forks, ACLs and extended attributes on that platform.
            if hasattr(os, "listxattr"):
                record["xattrs"] = {
                    attr: hashlib.sha256(os.getxattr(
                        path, attr, follow_symlinks=False)).hexdigest()
                    for attr in sorted(os.listxattr(path, follow_symlinks=False))
                }
            entries[rel] = record
    return hashlib.sha256(json.dumps(entries, sort_keys=True).encode()).hexdigest()


def mac_xattr_fingerprint(root):
    """Compare macOS extended-attribute values without Python's absent xattr API."""
    if sys.platform != "darwin":
        return None
    result = subprocess.run(["xattr", "-lr", "-s", "-x", str(root)],
                            capture_output=True, check=False)
    if result.returncode:
        raise RefreshError("Could not verify macOS extended attributes; originals retained")
    normalized = result.stdout.replace(os.fsencode(str(root)), b"<ROOT>")
    records = []
    current = []
    for line in normalized.splitlines(keepends=True):
        if line.startswith(b"<ROOT>") and b": " in line:
            if current:
                records.append(b"".join(current))
            current = [line]
        else:
            current.append(line)
    if current:
        records.append(b"".join(current))
    # macOS reassigns com.apple.provenance when a file is copied. It is OS
    # execution provenance, not a portable user attribute. Preserve and verify
    # all other xattrs, including Finder metadata and custom user attributes.
    records = [record for record in records
               if b": com.apple.provenance:" not in record.splitlines()[0]]
    return hashlib.sha256(b"".join(sorted(records))).hexdigest()


def recoveries_to_archive(repo):
    """Only complete, detached recoveries created by this script are eligible."""
    sibling = repo.with_name(f"{repo.name}.worktrees")
    if not sibling.is_dir() or sibling.is_symlink():
        return []
    candidates = []
    blocks = value(repo, "worktree", "list", "--porcelain").split("\n\n")
    common = Path(value(repo, "rev-parse", "--absolute-git-dir"))
    for block in blocks:
        lines = block.splitlines()
        if not lines or not lines[0].startswith("worktree "):
            continue
        source = Path(lines[0][len("worktree "):])
        if not source.name.startswith("recovery-"):
            continue
        if (source.is_symlink() or not source.is_dir() or
                not os.path.samefile(source.parent, sibling) or
                "detached" not in lines or any(line.startswith("locked") for line in lines)):
            continue
        admin = Path(value(source, "rev-parse", "--absolute-git-dir"))
        marker = git_path(source, "repo-refresh/recovery.json")
        if (not admin.is_dir() or not marker.is_file() or
                not os.path.samefile(admin.parent, common / "worktrees")):
            continue
        record = json.loads(marker.read_text())
        if record.get("complete") is not True or not isinstance(record.get("source"), str):
            continue
        # Rebase recoveries come from linked feature worktrees, not the
        # permanent checkout. Their original worktree might now be gone.
        original = Path(record["source"])
        if (original.exists() and
                not os.path.samefile(value(original, "rev-parse", "--path-format=absolute",
                                           "--git-common-dir"), common)):
            continue
        if any(git_path(source, state).exists() for state in ACTIVE_OPERATION_STATE):
            continue
        candidates.append((source, admin, record))
    return candidates


def replace_archived_recovery_reference(record, snapshots):
    previous = record.get("recovery")
    if previous in snapshots:
        record["recovery_archived_from"] = previous
        record["recovery"] = snapshots[previous]
        return True
    return False


def update_recovery_markers(repo, snapshots):
    # Existing failed rebases refer to a recovery path on every later run.
    # Redirect those paths to the independent archived Git worktree.
    for block in value(repo, "worktree", "list", "--porcelain").split("\n\n"):
        lines = block.splitlines()
        if not lines or not lines[0].startswith("worktree "):
            continue
        source = Path(lines[0][len("worktree "):])
        if not source.is_dir():
            continue
        marker = git_path(source, "repo-refresh-rebase.json")
        if marker.is_file():
            record = json.loads(marker.read_text())
            if replace_archived_recovery_reference(record, snapshots):
                write_json(marker, record)


def update_saved_status(state_dir, repo, snapshots):
    status_file = state_dir / "status.json"
    if not status_file.is_file():
        return
    status = json.loads(status_file.read_text())
    changed = False
    for outcome in status.get("repositories", []):
        if (not Path(outcome.get("repository", "")).exists() or
                not os.path.samefile(outcome["repository"], repo)):
            continue
        for record in [outcome, *outcome.get("branches", [])]:
            changed = replace_archived_recovery_reference(record, snapshots) or changed
    if changed:
        write_json(status_file, status)


def archive_recoveries(repo, archive_root):
    """Fully copy, verify, then deregister only explicitly marked recoveries."""
    candidates = recoveries_to_archive(repo)
    if not candidates:
        return None
    common = Path(value(repo, "rev-parse", "--absolute-git-dir"))
    if (common / "objects/info/alternates").exists():
        raise RefreshError("Git object alternates require an independent backup; worktrees retained")
    destination = archive_root / repo.name / (
        time.strftime("%Y-%m-%d--%H-%M-%S") + "-" + uuid.uuid4().hex[:10])
    destination.mkdir(parents=True, mode=0o700)
    os.chmod(destination, 0o700)
    archived_git = destination / "gitdir"
    manifest = {"repository": str(repo), "status": "copying",
                "created_at": time.time(), "snapshots": []}
    write_json(destination / "manifest.json", manifest)
    # A copy of the entire common Git database makes detached commits and
    # worktree indices available independently of the live checkout.
    copy_snapshot(common, archived_git)
    if (snapshot_fingerprint(common) != snapshot_fingerprint(archived_git)
            or mac_xattr_fingerprint(common) != mac_xattr_fingerprint(archived_git)):
        raise RefreshError(f"Git metadata archival verification failed: {destination}")
    for source, admin, record in candidates:
        archived = destination / "recoveries" / source.name
        archived.parent.mkdir(mode=0o700, exist_ok=True)
        copy_snapshot(source, archived)
        original_fingerprint = snapshot_fingerprint(source, skip_gitfile=True)
        if (original_fingerprint != snapshot_fingerprint(archived, skip_gitfile=True)
                or mac_xattr_fingerprint(source) != mac_xattr_fingerprint(archived)):
            # The .git pointer itself is intentionally rewritten below.
            raise RefreshError(f"Recovery content verification failed: {destination}")
        archived_admin = archived_git / "worktrees" / admin.name
        if not archived_admin.is_dir():
            raise RefreshError(f"Recovery Git index missing from archive: {destination}")
        archived_head = value(source, "rev-parse", "HEAD")
        original_status = git(source, "status", "--porcelain=v1", "-z",
                              "--untracked-files=all").stdout
        original_index = git(source, "ls-files", "--stage", "-z").stdout
        original_xattrs = mac_xattr_fingerprint(source)
        # Change only the *copied* administrative pointers. The snapshot is
        # then a usable Git worktree of the archived, independent Git database.
        (archived / ".git").write_text(f"gitdir: {archived_admin}\n")
        (archived_admin / "gitdir").write_text(str(archived / ".git") + "\n")
        if (value(archived, "rev-parse", "HEAD") != archived_head
                or not os.path.samefile(value(archived, "rev-parse",
                                              "--path-format=absolute", "--git-common-dir"),
                                        archived_git)
                or git(archived, "status", "--porcelain=v1", "-z",
                       "--untracked-files=all").stdout != original_status
                or git(archived, "ls-files", "--stage", "-z").stdout != original_index
                or original_fingerprint != snapshot_fingerprint(archived, skip_gitfile=True)):
            raise RefreshError(f"Recovery Git verification failed: {destination}")
        manifest["snapshots"].append({
            "source": str(source), "archived": str(archived),
            "head": archived_head, "fingerprint": original_fingerprint,
            "admin": admin.name, "removed": False,
            "index_sha256": hashlib.sha256(original_index).hexdigest(),
            "status_sha256": hashlib.sha256(original_status).hexdigest(),
            "xattrs_sha256": original_xattrs,
        })
        write_json(destination / "manifest.json", manifest)
    manifest["status"] = "verified"
    write_json(destination / "manifest.json", manifest)
    # Never remove an original until all copies are verified and durable.
    # Recheck each live source immediately before removing it to detect edits
    # made while the long batch copy was in progress.
    for item in manifest["snapshots"]:
        source = Path(item["source"])
        if (snapshot_fingerprint(source, skip_gitfile=True) != item["fingerprint"]
                or mac_xattr_fingerprint(source) != item["xattrs_sha256"]
                or hashlib.sha256(git(source, "ls-files", "--stage", "-z").stdout).hexdigest()
                != item["index_sha256"]
                or hashlib.sha256(git(source, "status", "--porcelain=v1", "-z",
                                      "--untracked-files=all").stdout).hexdigest()
                != item["status_sha256"]):
            raise RefreshError(f"Recovery changed during archival; originals retained: {destination}")
        git(repo, "worktree", "remove", "--force", "--force", source)
        item["removed"] = True
        write_json(destination / "manifest.json", manifest)
    manifest["status"] = "archived"
    write_json(destination / "manifest.json", manifest)
    snapshots = {item["source"]: item["archived"] for item in manifest["snapshots"]}
    update_recovery_markers(repo, snapshots)
    return {"directory": str(destination), "count": len(candidates),
            "snapshots": snapshots}


def refresh_one(repo, remote, archive_root=None):
    outcome = {"repository": str(repo)}
    try:
        # The common directory is the lock boundary shared by linked worktrees.
        common = Path(value(repo, "rev-parse", "--path-format=absolute", "--git-common-dir"))
        with (common / "repo-refresh.lock").open("a") as repo_lock:
            fcntl.flock(repo_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if repair_permanent_checkout_path(repo):
                outcome["repaired_checkout_path"] = True
            outcome.update(refresh(repo, remote))
            outcome["branches"] = rebase_branches(repo, outcome["branch"], outcome["commit"], remote)
            for branch in outcome["branches"]:
                if branch.get("worktree") == outcome.get("recovery") and branch.get("recovery"):
                    outcome["development_worktree"] = outcome["recovery"]
                    outcome["recovery"] = branch["recovery"]
                    break
            if archive_root is not None:
                archived = archive_recoveries(repo, archive_root)
                if archived:
                    outcome["archived_recoveries"] = archived["count"]
                    outcome["archive_directory"] = archived["directory"]
                    for entry in [outcome, *outcome["branches"]]:
                        if entry.get("recovery") in archived["snapshots"]:
                            entry["recovery"] = archived["snapshots"][entry["recovery"]]
    except BlockingIOError:
        outcome.update(state="busy")
    except (RefreshError, OSError, shutil.Error) as error:
        # Low-level exception text may include credential-bearing URLs.
        message = str(error) if isinstance(error, RefreshError) else type(error).__name__
        outcome.update(state="failed", error=message)
    return outcome


def run(config_path, state_dir):
    if not config_path.exists():
        return 0
    config = json.loads(config_path.read_text())
    if not isinstance(config.get("enabled", True), bool):
        raise RefreshError("enabled must be a JSON boolean")
    if not isinstance(config.get("archiveRecoveries", False), bool):
        raise RefreshError("archiveRecoveries must be a JSON boolean")
    setting = config.get("root")
    if (not isinstance(setting, str) or not setting.strip()
            or not Path(setting).expanduser().is_absolute()):
        raise RefreshError("root must be an absolute path or start with ~/")
    if "worktrees" in config:
        raise RefreshError("Remove obsolete 'worktrees' setting; paths are derived from each repository")
    root = Path(setting).expanduser().resolve()
    remote = config.get("remote", "origin")
    if not isinstance(remote, str) or not remote or remote.startswith("-"):
        raise RefreshError("remote must be a nonempty Git remote name")
    if not config.get("enabled", True):
        return 0
    if not root.is_dir():
        raise RefreshError("Configured repository root is not a directory")
    archive_root = Path.home() / "Archives/repo-refresh" if config.get("archiveRecoveries", False) else None
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state_dir / "run.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        outcomes = []
        with ThreadPoolExecutor(max_workers=4) as pool:
            pending = [pool.submit(refresh_one, repo, remote, archive_root)
                       for repo in repositories(root)]
            for future in as_completed(pending):
                outcome = future.result()
                outcomes.append(outcome)
                write_json(state_dir / "status.json", {"checked_at": time.time(), "repositories": outcomes})
                if outcome["state"] != "current" or any(
                    branch["state"] != "current" for branch in outcome.get("branches", [])
                ):
                    print(json.dumps(outcome), flush=True)
        write_json(state_dir / "status.json", {"checked_at": time.time(), "repositories": outcomes})
        return int(any(item["state"] == "failed" or any(
            branch["state"] == "failed" for branch in item.get("branches", [])
        ) for item in outcomes))


def archive_existing(config_path, state_dir, selected_repository=None):
    if not config_path.is_file():
        raise RefreshError("Repository configuration not found")
    config = json.loads(config_path.read_text())
    root = Path(config["root"]).expanduser().resolve()
    if not root.is_dir():
        raise RefreshError("Configured repository root is not a directory")
    state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    candidates = list(repositories(root))
    if selected_repository is not None:
        target = selected_repository.expanduser().resolve()
        candidates = [repo for repo in candidates if os.path.samefile(repo, target)] if target.is_dir() else []
        if len(candidates) != 1:
            raise RefreshError("Selected repository is not a direct checkout under the configured root")
    with (state_dir / "run.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for repo in candidates:
            common = Path(value(repo, "rev-parse", "--absolute-git-dir"))
            with (common / "repo-refresh.lock").open("a") as repo_lock:
                fcntl.flock(repo_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                result = archive_recoveries(repo, Path.home() / "Archives/repo-refresh")
                if result:
                    update_saved_status(state_dir, repo, result["snapshots"])
                    print(json.dumps({"repository": str(repo), **result}), flush=True)
    return 0


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path,
                        default=Path.home() / ".config/repo-refresh/config.json")
    parser.add_argument("--state-dir", type=Path,
                        default=Path.home() / ".local/state/repo-refresh")
    parser.add_argument("--status", action="store_true", help="show the last scheduled run")
    parser.add_argument("--archive-recoveries", action="store_true",
                        help="verify and archive detached recovery worktrees without refreshing repos")
    parser.add_argument("--repository", type=Path,
                        help="limit manual archival to one permanent checkout")
    args = parser.parse_args()
    try:
        if args.status:
            path = args.state_dir / "status.json"
            print(path.read_text() if path.exists() else "No runs recorded.")
            return 0
        if args.archive_recoveries:
            return archive_existing(args.config, args.state_dir, args.repository)
        if args.repository is not None:
            raise RefreshError("--repository requires --archive-recoveries")
        return run(args.config, args.state_dir)
    except (RefreshError, OSError, ValueError, KeyError, TypeError) as error:
        message = str(error) if isinstance(error, RefreshError) else type(error).__name__
        print(f"repo-refresh: {message}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
