#!/usr/bin/env python3
"""Create and remove isolated Git review worktrees."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def git(*args: str, cwd: Path | None = None, capture: bool = True) -> str:
    result = subprocess.run(
        ["git", *args], cwd=cwd, check=True, text=True,
        stdout=subprocess.PIPE if capture else None,
    )
    return result.stdout.strip() if capture else ""


def common_dir(cwd: Path) -> Path:
    return Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=cwd))


def source_root(cwd: Path) -> Path:
    return Path(git("rev-parse", "--show-toplevel", cwd=cwd))


def repository_name(common: Path) -> str:
    """Derive the stable repository label from its common Git directory."""
    return common.parent.name if common.name == ".git" else common.name


def bounded_name(name: str, max_bytes: int) -> str:
    """Truncate on UTF-8 boundaries to respect filesystem component limits."""
    return name.encode("utf-8")[:max_bytes].decode("utf-8", "ignore")


def state_root(common: Path) -> Path:
    # The digest ensures identity even when very long names are abbreviated.
    repo_name = bounded_name(repository_name(common), 96)
    digest = hashlib.sha256(str(common).encode()).hexdigest()[:10]
    return Path.home() / ".local" / "share" / "git-review" / f"{repo_name}-{digest}"


def default_base(cwd: Path) -> str:
    branch = git("branch", "--show-current", cwd=cwd)
    config_remote = subprocess.run(
        ["git", "config", "--get", f"branch.{branch}.remote"],
        cwd=cwd, text=True, stdout=subprocess.PIPE,
    ).stdout.strip() if branch else ""
    remote = config_remote if config_remote and config_remote != "." else "origin"
    git("fetch", remote, cwd=cwd, capture=False)
    subprocess.run(
        ["git", "remote", "set-head", remote, "--auto"],
        cwd=cwd,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        return git("symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD", cwd=cwd)
    except subprocess.CalledProcessError as exc:
        raise SystemExit(f"Cannot determine {remote}'s default branch.") from exc


def workspace_directory(review: Path) -> Path:
    # VS Code can discover the SOURCE checkout when the workspace file lives
    # inside its .git/worktrees directory. Keep it outside all Git trees.
    return review.parent / "workspaces" / review.name


def review_workspace(review: Path, repo_name: str, target_sha: str) -> Path:
    """Name the editor window without exposing the source checkout to Git scanning."""
    name = f"{bounded_name(repo_name, 96)} · review · {target_sha[:7]}"
    directory = workspace_directory(review)
    directory.mkdir(parents=True, exist_ok=True)
    workspace = directory / f"{name}.code-workspace"
    workspace.write_text(json.dumps({
        "folders": [{"name": f"{repo_name} · review", "path": str(review)}],
    }, indent=2) + "\n")
    return workspace


def open_vscode(path: Path) -> None:
    code = shutil.which("code")
    if code:
        # Shell-based Git aliases can export GIT_DIR, GIT_WORK_TREE, GIT_PREFIX
        # and other repository-local variables. Passing them to VS Code makes
        # its Git extension treat unrelated folders as the source repository.
        # Use Git's authoritative list instead of manually maintaining one.
        env = os.environ.copy()
        local_vars = git("rev-parse", "--local-env-vars").splitlines()
        for name in local_vars:
            env.pop(name, None)
        subprocess.run([code, "-r", str(path)], check=True, env=env)
    else:
        print(f"Review worktree ready: {path}")


def is_registered_worktree(source: Path, path: Path) -> bool:
    listing = git("worktree", "list", "--porcelain", "-z", cwd=source)
    return any(
        field == f"worktree {path}"
        for field in listing.split("\0")
    )


def create_review(cwd: Path, base: str, target: str, mode: str) -> Path:
    source = source_root(cwd)
    common = common_dir(cwd)
    target_sha = git("rev-parse", target, cwd=cwd)
    base_sha = git("rev-parse", base, cwd=cwd)
    material_base = git("merge-base", base_sha, target_sha, cwd=cwd) if mode == "range" else base_sha

    root = state_root(common)
    root.mkdir(parents=True, exist_ok=True)
    review = Path(tempfile.mkdtemp(prefix="review-", dir=root))
    try:
        git("worktree", "add", "--detach", str(review), material_base, cwd=source, capture=False)
        # Defense in depth before destructive resets: a polluted environment
        # must never redirect them to the original checkout (or another repo).
        if (
            source_root(review).resolve() != review.resolve()
            or common_dir(review).resolve() != common.resolve()
            or not is_registered_worktree(source, review)
        ):
            raise RuntimeError("Refusing to reset: disposable Git review worktree is not verified")
        # Materialize the exact target tree, then return HEAD/index to the
        # review base while preserving the target files as unstaged changes.
        # Applying a patch with --index is fragile when checkout filters or
        # line-ending conversion make worktree bytes differ from index blobs.
        git("reset", "--hard", target_sha, cwd=review, capture=False)
        git("reset", "--mixed", material_base, cwd=review, capture=False)
        metadata = {
            "git_review": True,
            "source_worktree": str(source),
            "base": material_base,
            "target": target_sha,
            "mode": mode,
        }
        review_git_dir = Path(git("rev-parse", "--path-format=absolute", "--git-dir", cwd=review))
        (review_git_dir / "GIT_REVIEW.json").write_text(json.dumps(metadata, indent=2) + "\n")
        open_vscode(review_workspace(review, repository_name(common), target_sha))
        print(review)
        return review
    except BaseException:
        shutil.rmtree(workspace_directory(review), ignore_errors=True)
        try:
            if is_registered_worktree(source, review):
                subprocess.run(
                    ["git", "worktree", "remove", "--force", str(review)],
                    cwd=source,
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            if review.exists() and not is_registered_worktree(source, review):
                shutil.rmtree(review, ignore_errors=True)
        except BaseException:
            pass
        raise


def unreview(cwd: Path) -> None:
    review = source_root(cwd)
    review_git_dir = Path(git("rev-parse", "--path-format=absolute", "--git-dir", cwd=review))
    marker = review_git_dir / "GIT_REVIEW.json"
    if not marker.exists():
        # User tasks run from the workspace folder, which can still be the
        # source checkout while VS Code displays files from a review worktree.
        candidates = []
        listing = git("worktree", "list", "--porcelain", "-z", cwd=review)
        for field in listing.split("\0"):
            if not field.startswith("worktree "):
                continue
            candidate = Path(field[len("worktree "):])
            if not candidate.is_dir():
                continue
            candidate_git_dir = Path(git(
                "rev-parse", "--path-format=absolute", "--git-dir", cwd=candidate,
            ))
            candidate_marker = candidate_git_dir / "GIT_REVIEW.json"
            if not candidate_marker.exists():
                continue
            data = json.loads(candidate_marker.read_text())
            if data.get("git_review") and Path(data["source_worktree"]) == review:
                candidates.append((candidate, candidate_marker))
        if len(candidates) != 1:
            if candidates:
                raise SystemExit("Multiple review worktrees found. Run git unreview inside the review you want to close.")
            raise SystemExit("No Git review worktree found for this checkout.")
        review, marker = candidates[0]
    data = json.loads(marker.read_text())
    if not data.get("git_review"):
        raise SystemExit("Invalid Git review metadata.")
    source = Path(data["source_worktree"])
    open_vscode(source)
    # Remove the independent workspace first. If deletion fails or the process
    # is interrupted, the review is still registered and unreview is retryable.
    # No silent ignore_errors: expose failure rather than stranding metadata.
    directory = workspace_directory(review)
    if directory.exists():
        shutil.rmtree(directory)
    git("worktree", "remove", "--force", str(review), cwd=source, capture=False)
    print(source)


def main() -> None:
    # Git shell aliases pass repository-specific environment into this helper.
    # Our subprocesses must discover the repository from their own cwd, and
    # VS Code must not inherit the caller's GIT_DIR/GIT_WORK_TREE/etc.
    for name in git("rev-parse", "--local-env-vars").splitlines():
        os.environ.pop(name, None)

    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    one = sub.add_parser("commit")
    one.add_argument("commit")
    rng = sub.add_parser("range")
    rng.add_argument("base", nargs="?")
    rng.add_argument("target", nargs="?", default="HEAD")
    sub.add_parser("unreview")
    args = parser.parse_args()
    cwd = Path.cwd()

    if args.command == "commit":
        commit = git("rev-parse", args.commit, cwd=cwd)
        try:
            parent = git("rev-parse", f"{commit}^", cwd=cwd)
        except subprocess.CalledProcessError as exc:
            raise SystemExit(
                "Cannot review a root commit because it has no parent to compare."
            ) from exc
        create_review(cwd, parent, commit, "commit")
    elif args.command == "range":
        create_review(cwd, args.base or default_base(cwd), args.target, "range")
    else:
        unreview(cwd)


if __name__ == "__main__":
    main()
