#!/bin/sh
set -eu
if [ "$#" -ne 1 ]; then
  echo "Usage: skillport-mcp-configure tunnel_ID" >&2
  exit 2
fi
case "$1" in
  tunnel_*) ;;
  *) echo "Expected a tunnel_... ID" >&2; exit 2 ;;
esac
case "$1" in
  *[!a-zA-Z0-9_-]*) echo "Invalid tunnel ID" >&2; exit 2 ;;
esac
config="$HOME/.config/skillport-mcp"
if [ -e "$config/tunnel-id" ]; then
  echo "Already configured at $config/tunnel-id; will not overwrite." >&2
  exit 1
fi
umask 077
mkdir -p "$config"
printf '%s\n' "$1" > "$config/tunnel-id"
echo "Tunnel ID configured. Stop any other tunnel-client using the same ID before applying dotfiles."
