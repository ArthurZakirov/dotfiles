#!/usr/bin/env python3
"""Compact, read-only five-stage AGENTS.md indicator for Codex CLI."""
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys

STAGES = ("github", "local", "generated", "deployed", "session")
SYMBOLS = {"current": "✓", "outdated": "✕", "unknown": "?"}
LABELS = "GLRCS"


def check() -> str:
    """Return a truthful five-stage indicator, including unknown checks."""
    unknown = "AGENTS " + " ".join(f"{label}?" for label in LABELS)
    session_id = os.environ.get("CODEX_THREAD_ID")
    codex_home = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    pipeline = codex_home / "hooks-json/agents-md-freshness/pipeline.py"
    if not pipeline.is_file():
        return unknown
    try:
        output = subprocess.run(
            [sys.executable, str(pipeline), "--codex-home", str(codex_home)]
            + (["--session-id", session_id] if session_id else []),
            capture_output=True, text=True, timeout=25, check=False,
        )
        if output.returncode != 0:
            return unknown
        payload = json.loads(output.stdout)
        stages = payload.get("stages", [])
        if [stage.get("key") for stage in stages] != list(STAGES):
            return unknown
        symbols = [SYMBOLS.get(stage.get("status"), "?") for stage in stages]
        return "AGENTS " + " ".join(
            f"{label}{symbol}" for label, symbol in zip(LABELS, symbols)
        )
    except (OSError, ValueError, subprocess.TimeoutExpired, TypeError):
        return unknown


if __name__ == "__main__":
    print(check())
