#!/usr/bin/env python3
"""Prepare a checkout-local environment from an existing, fresh Poetry lock."""
import hashlib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from urllib.parse import urlsplit

EXPORTER = ["uv", "tool", "run", "--from", "poetry==2.4.1", "--with", "poetry-plugin-export==1.10.1", "poetry"]
CACHE_VERSION = b"pysetup-v1:poetry-2.4.1:export-1.10.1:all-groups:hashes"
UV = shutil.which("uv") or "/opt/homebrew/bin/uv"


class SetupError(Exception):
    pass


def run(args, label, cwd, report=True):
    """Execute a subprocess without printing potentially sensitive diagnostics."""
    if args[0] == "uv":
        args = [UV, *args[1:]]
    start = time.monotonic()
    options = {"env": os.environ | {"UV_PYTHON_DOWNLOADS": "automatic"}} if label == "Environment creation" else {}
    result = subprocess.run(args, cwd=cwd, capture_output=True, **options)
    elapsed = time.monotonic() - start
    if result.returncode:
        diagnostic = result.stderr.lower()
        if label == "Environment creation":
            reason = "Matching Python could not be obtained or the environment could not be created. Check network access and retry the task; no system Python was replaced."
        elif b"401" in diagnostic or b"403" in diagnostic:
            reason = "Private package authentication failed. Sign in with uv in your own terminal, then retry."
        elif b"lock" in diagnostic and label in ("Lock check", "Export"):
            reason = "Poetry lock is missing, stale, or incompatible. Update it through the project's normal workflow."
        elif b"failed to build" in diagnostic:
            reason = "A locked package could not build for this Python version. No dependency versions were changed."
        else:
            reason = "Command failed; raw diagnostics suppressed to protect credentials."
        raise SetupError(f"{label}: {reason}")
    if report:
        print(f"{label}: {elapsed:.2f}s", flush=True)
    return result.stdout


def python_spec(requirement):
    """Translate common Poetry Python constraints to uv's version request syntax."""
    if not isinstance(requirement, str) or "||" in requirement:
        raise SetupError("Unsupported Python constraint; no environment was changed.")
    parts = []
    for item in requirement.split(","):
        item = item.strip()
        if item.startswith(("^", "~")) and not item.startswith("~="):
            match = re.fullmatch(r"([\^~])(\d+)(?:\.(\d+))?(?:\.(\d+))?", item)
            if not match:
                raise SetupError("Unsupported Python constraint; no environment was changed.")
            marker, major, minor, patch = match.groups()
            supplied = [int(v) for v in (major, minor, patch) if v is not None]
            lower = supplied + [0] * (3 - len(supplied))
            upper = lower.copy()
            boundary = (next((i for i, v in enumerate(lower) if v), 2) if marker == "^" else (1 if len(supplied) >= 2 else 0))
            upper[boundary] += 1
            upper[boundary + 1:] = [0] * (2 - boundary)
            parts.extend([">=" + ".".join(map(str, lower)), "<" + ".".join(map(str, upper))])
        elif item == "*":
            continue
        elif re.fullmatch(r"\d+(?:\.\d+){0,2}(?:\.\*)?", item):
            parts.append("==" + item)
        elif re.fullmatch(r"(?:>=|<=|!=|==|~=|>|<)\s*\d+(?:\.\d+){0,2}(?:\.\*)?", item):
            parts.append(item.replace(" ", ""))
        else:
            raise SetupError("Unsupported Python constraint; no environment was changed.")
    return ",".join(parts) or ">=3"


def safe_export(path):
    """Never cache or install requirements containing credential-capable URLs."""
    for line in path.read_text().splitlines():
        for url in re.findall(r"https?://\S+", line):
            parsed = urlsplit(url)
            if parsed.username is not None or parsed.password is not None or parsed.query or parsed.fragment:
                raise SetupError("Export contains a credential-capable URL; it will not be cached or installed.")


def create_environment(spec, environment, root):
    """Create a checkout-local environment, preferring a specific minor series."""
    bounds = re.findall(r"(?:>=|>|==|~=)(\d+)\.(\d+)", spec)
    lower = max((tuple(map(int, bound)) for bound in bounds), default=None)
    # A major-only constraint such as ^3 must not become ==3.0.*.
    lower = lower if lower and lower[1] > 0 else None
    preferred = spec + ",==" + ".".join(map(str, lower)) + ".*" if lower else spec
    run(["uv", "venv", "--no-project", "--python", preferred, str(environment)], "Environment creation", root)


def verify_environment(interpreter, environment, root):
    """Reject non-venv interpreters before any potentially destructive sync."""
    if not (environment / "pyvenv.cfg").is_file() or not interpreter.is_file():
        raise SetupError("Existing .venv is not a usable Python environment; it was preserved.")
    output = run([str(interpreter), "-I", "-c",
                  "import json,sys; print(json.dumps([sys.prefix,sys.base_prefix, '.'.join(map(str,sys.version_info[:3]))]))"],
                 "Interpreter check", root, False)
    import json
    prefix, base_prefix, version = json.loads(output)
    if Path(prefix).resolve() != environment.resolve() or Path(prefix).resolve() == Path(base_prefix).resolve():
        raise SetupError("Existing .venv is not isolated at the expected path; it was preserved.")
    return version


def main():
    """Validate the lock and synchronize only a verified checkout environment."""
    start = time.monotonic()
    root = Path(sys.argv[1]).absolute() if len(sys.argv) == 2 else Path.cwd()
    if len(sys.argv) > 2:
        raise SetupError("Usage: pysetup [checkout-directory]")
    manifest, lock = root / "pyproject.toml", root / "poetry.lock"
    if not manifest.is_file() or not lock.is_file():
        raise SetupError("This folder needs both pyproject.toml and poetry.lock. Nothing changed.")
    if not Path(UV).is_file():
        raise SetupError("uv is required; it was not installed automatically.")
    manifest_bytes, lock_bytes = manifest.read_bytes(), lock.read_bytes()
    metadata = tomllib.loads(manifest_bytes.decode())
    poetry = metadata.get("tool", {}).get("poetry", {})
    requirement = poetry.get("dependencies", {}).get("python") or metadata.get("project", {}).get("requires-python")
    if requirement is None:
        raise SetupError("Declare a Python requirement before setting up this environment.")
    spec = python_spec(requirement)
    key = hashlib.sha256(CACHE_VERSION + b"\0" + manifest_bytes + b"\0" + lock_bytes).hexdigest()
    cache = Path.home() / "Library/Caches/pysetup"
    cache.mkdir(parents=True, exist_ok=True, mode=0o700)
    requirements = cache / (key + ".requirements.txt")
    if requirements.exists():
        safe_export(requirements)
        print("Lock export: cached (unchanged manifest and lock)", flush=True)
    else:
        run(EXPORTER + ["check", "--lock"], "Lock check", root)
        with tempfile.TemporaryDirectory(prefix="pysetup-") as temporary:
            output = Path(temporary) / "requirements.txt"
            run(EXPORTER + ["export", "--all-groups", "-f", "requirements.txt", "-o", str(output)], "Export", root)
            safe_export(output)
            with tempfile.NamedTemporaryFile(dir=cache, delete=False) as staged:
                staged.write(output.read_bytes())
                staged_path = Path(staged.name)
            staged_path.replace(requirements)
    if manifest.read_bytes() != manifest_bytes or lock.read_bytes() != lock_bytes:
        raise SetupError("Dependency files changed during setup; retry before installing.")
    environment = root / ".venv"
    interpreter = environment / "bin/python"
    if environment.exists():
        version = verify_environment(interpreter, environment, root)
        run(["uv", "python", "find", "--no-project", "--no-python-downloads", spec + ",==" + version], "Python compatibility", root, False)
        print("Environment: reused", flush=True)
    else:
        create_environment(spec, environment, root)
    # Verify even freshly created environments before invoking a destructive sync.
    verify_environment(interpreter, environment, root)
    run(["uv", "pip", "sync", "--python", str(interpreter), "--require-hashes", str(requirements)], "Locked dependency sync", root)
    if poetry.get("package-mode", True):
        run(["uv", "pip", "install", "--python", str(interpreter), "--no-deps", "--editable", str(root)], "Editable project install", root)
    run(["uv", "pip", "check", "--python", str(interpreter)], "Dependency verification", root)
    ignored = subprocess.run(["git", "check-ignore", "-q", ".venv/"], cwd=root, capture_output=True)
    if ignored.returncode:
        result = subprocess.run(["git", "rev-parse", "--git-path", "info/exclude"], cwd=root, capture_output=True)
        if result.returncode == 0:
            exclude = Path(result.stdout.decode().strip())
            if not exclude.is_absolute():
                exclude = root / exclude
            exclude.parent.mkdir(parents=True, exist_ok=True)
            with exclude.open("a") as stream:
                stream.write("\n.venv/\n")
    print(f"Ready: {interpreter}\nTotal: {time.monotonic() - start:.2f}s", flush=True)


if __name__ == "__main__":
    try:
        main()
    except SetupError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
    except (Exception, KeyboardInterrupt):
        print("Setup stopped; diagnostics suppressed to protect credentials. Existing files were preserved.", file=sys.stderr)
        sys.exit(1)
