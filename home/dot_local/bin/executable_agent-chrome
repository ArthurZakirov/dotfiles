#!/bin/sh
# Share an ordinary Chrome connection across Codex chats on this machine.
# Classify without changing the arguments forwarded to agent-browser.
# Help/version take precedence anywhere, matching agent-browser 0.39's main.rs.
chrome_command=
for chrome_arg do
    case "$chrome_arg" in
        --help|-h|--version|-V) chrome_command=help; break ;;
    esac
done
chrome_global_value_flag() {
    case "$1" in
        --session|--restore-save|--restore-check-url|--restore-check-text|\
        --restore-check-fn|--namespace|--headers|--executable-path|--cdp|\
        --extension|--init-script|--enable|--profile|--state|--proxy|\
        --proxy-bypass|--args|--user-agent|-p|--provider|--device|\
        --session-name|--color-scheme|--download-path|--max-output|\
        --allowed-domains|--action-policy|--confirm-actions|--config|\
        --engine|--input-mode|--screenshot-dir|--screenshot-quality|\
        --screenshot-format|--idle-timeout|--ca-cert|--model) return 0 ;;
        *) return 1 ;;
    esac
}
# Preflight only visible CLI modes rejected by incompatible_launch_mode_error.
# Scan past the command too, honoring option values and last boolean overrides.
chrome_launch_compatible=yes
check_chrome_launch_mode() {
    chrome_webgpu=no
    chrome_ca_cert=no
    chrome_external_mode=no
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --webgpu)
                chrome_webgpu=yes
                shift
                case "${1-}" in
                    false) chrome_webgpu=no; shift ;;
                    true) shift ;;
                esac
                ;;
            --no-ca-cert)
                shift
                case "${1-}" in
                    false) shift ;;
                    true) chrome_ca_cert=no; shift ;;
                    *) chrome_ca_cert=no ;;
                esac
                ;;
            *)
                if chrome_global_value_flag "$1" && [ "$#" -ge 2 ]; then
                    case "$1" in
                        --cdp|-p|--provider) chrome_external_mode=yes ;;
                        --ca-cert) chrome_ca_cert=yes ;;
                    esac
                    shift 2
                else
                    shift
                fi
                ;;
        esac
    done
    if [ "$chrome_external_mode" = yes ] || [ "$chrome_ca_cert" = yes ] || [ "$chrome_webgpu" = yes ]; then
        chrome_launch_compatible=no
    fi
}
check_chrome_launch_mode "$@"
classify_chrome_command() {
    # Match 0.39's flags.rs clean_args for global prefixes. A function keeps
    # shift local: the final exec still receives the caller's original argv.
    while [ "$#" -gt 0 ]; do
        if chrome_global_value_flag "$1"; then
            [ "$#" -ge 2 ] || return
            shift 2
            continue
        fi
        case "$1" in
            --llms|--filter|--timeout)
                [ "$chrome_command" = read ] && [ "$#" -ge 2 ] || return
                shift 2
                ;;
            --raw|--require-md|--outline)
                [ "$chrome_command" = read ] || return
                shift
                ;;
            --json|--headed|--webgpu|--no-webmcp|--debug|\
            --ignore-https-errors|--allow-file-access|--hide-scrollbars|\
            --auto-connect|--pin-tab|--no-pin-tab|--no-ca-cert|--use-system-ca|\
            --annotate|--content-boundaries|--confirm-interactive|\
            --no-auto-dialog|-v|--verbose|-q|--quiet|--offline|--quick|--fix)
                shift
                case "${1-}" in true|false) shift ;; esac
                ;;
            # Restore overrides are outside the shared regular-Chrome flow.
            # Unknown options likewise get no automatic OS launch side effect.
            --restore|--restore=*|-*) return ;;
            *)
                if [ "$chrome_command" = read ]; then
                    chrome_command=direct-read
                    return
                fi
                case "$chrome_command:$1" in
                    # Local actions from state.rs and actions.rs skip_launch_action.
                    state:list|state:show|state:clear|state:clean|state:rename|\
                    auth:save|auth:show|auth:delete|auth:list|\
                    webmcp:result|webmcp:cancel|network-har:stop)
                        chrome_command=local-only
                        return
                        ;;
                    network:har)
                        chrome_command=network-har
                        shift
                        continue
                        ;;
                esac
                [ -z "$chrome_command" ] || return
                chrome_command=$1
                case "$chrome_command" in state|read|auth|webmcp|network) ;; *) return ;; esac
                shift
                ;;
        esac
    done
}
if [ -z "$chrome_command" ]; then
    classify_chrome_command "$@"
fi
chrome_auto_connect=yes
case "$chrome_command" in
    '') ;;
    help|version|skills|close|quit|exit|install|upgrade|doctor|dashboard|\
    profiles|plugin|plugins|mcp|session|direct-read|batch|local-only|\
    device|stream|confirm|deny) chrome_auto_connect=no ;;
    *)
        if [ "$(uname -s)" = Darwin ] && [ "$chrome_launch_compatible" = yes ]; then
            # pgrep exit 1 means absent only when process inspection succeeded.
            process_error=$(pgrep -x 'Google Chrome' 2>&1 >/dev/null)
            process_status=$?
            if [ "$process_status" -eq 1 ] && [ -z "$process_error" ]; then
                if ! open -a 'Google Chrome'; then
                    echo 'agent-chrome: ordinary Chrome launch failed; connection not attempted.' >&2
                    exit 1
                fi
                # Bound startup waiting; never kill/restart an existing Chrome.
                attempt=0
                while [ "$attempt" -le 10 ]; do
                    process_error=$(pgrep -x 'Google Chrome' 2>&1 >/dev/null)
                    process_status=$?
                    [ "$process_status" -ne 0 ] || break
                    if [ "$process_status" -ne 1 ] || [ -n "$process_error" ]; then
                        echo 'agent-chrome: Chrome process inspection unavailable after launch; browser state unknown. Attempting normal connection.' >&2
                        break
                    fi
                    if [ "$attempt" -eq 10 ]; then
                        echo 'agent-chrome: Chrome did not become observable after launch; connection not attempted.' >&2
                        exit 1
                    fi
                    attempt=$((attempt + 1))
                    sleep 1
                done
            elif [ "$process_status" -ne 0 ]; then
                echo 'agent-chrome: Chrome process inspection unavailable; browser state unknown. Attempting normal connection.' >&2
            fi
        fi
        ;;
esac
if [ "$chrome_auto_connect" = no ]; then
    # An explicit attachment would make browserless/local work depend on Chrome.
    exec agent-browser --session dotfiles-chrome --pin-tab "$@"
fi
exec agent-browser --session dotfiles-chrome --auto-connect --pin-tab "$@"
