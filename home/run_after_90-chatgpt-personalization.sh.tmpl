#!/bin/sh
set -eu

{{ if eq .profile "personal" -}}
instructions={{ (printf "%s/src/chatgpt/personalization-instructions.md" .chezmoi.workingTree) | quote }}
if [ -f "$instructions" ]; then
  printf '\n  -- CHATGPT PERSONALIZATION (MANUAL) --\n'
  printf 'Instructions file: %s\n' "$instructions"
  printf 'Paste into ChatGPT: %s\n' 'https://chatgpt.com/settings/personalization?instructions=chatgpt'
  printf '%s\n' 'Copy the file contents into ChatGPT Custom Instructions manually.'
else
  printf 'ChatGPT instructions not found: %s\n' "$instructions" >&2
fi
{{ end -}}
