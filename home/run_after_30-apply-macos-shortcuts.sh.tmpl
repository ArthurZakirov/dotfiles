{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Use the source checkout so this works on a fresh Mac before executable setup.
# The importer checks that chezmoi targets the current login user's home.
if [ -r {{ (printf "%s/src/provisioning-log.sh" .chezmoi.workingTree) | quote }} ]; then
  source {{ (printf "%s/src/provisioning-log.sh" .chezmoi.workingTree) | quote }}
  dotfiles_section "MACOS KEYBOARD SHORTCUTS"
fi
python3 {{ (printf "%s/src/macos_shortcuts.py" .chezmoi.workingTree) | quote }} apply {{ (printf "%s/home/dot_config/macos-shortcuts/shortcuts.json" .chezmoi.workingTree) | quote }} --yes
{{ end -}}
