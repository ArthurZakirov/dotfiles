#!/bin/bash
set -euo pipefail
[[ "$(uname -s)" == Darwin ]] || exit 0
DOTFILES_ROOT={{ .chezmoi.workingTree | quote }}
source "$DOTFILES_ROOT/src/homebrew.sh"
configure_homebrew
source "$DOTFILES_ROOT/src/provisioning-log.sh"
dotfiles_subsection "BROWSER USE"
export UV_TOOL_BIN_DIR="$HOME/.local/bin"
uv tool install 'browser-use==1.0.5'
"$UV_TOOL_BIN_DIR/browser-use" --version
python3 "$DOTFILES_ROOT/src/retire-agent-browser-skill.py"
