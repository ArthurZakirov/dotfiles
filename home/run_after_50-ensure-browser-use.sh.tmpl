#!/bin/bash
set -euo pipefail
[[ "$(uname -s)" == Darwin ]] || exit 0
DOTFILES_ROOT={{ .chezmoi.workingTree | quote }}
source "$DOTFILES_ROOT/src/homebrew.sh"
configure_homebrew
source "$DOTFILES_ROOT/src/provisioning-log.sh"
dotfiles_subsection "BROWSER USE"
# Keep uv's three entry points separate from pipx and user-owned installations.
managed="$HOME/.local/share/dotfiles/browser-use"
export UV_TOOL_DIR="$managed/tools" UV_TOOL_BIN_DIR="$managed/bin"
uv tool install 'browser-use==1.0.5'
"$UV_TOOL_BIN_DIR/browser-use" --version
mkdir -p "$HOME/.local/bin"
shortcut="$HOME/.local/bin/browser-use"
if [[ ! -e "$shortcut" && ! -L "$shortcut" ]]; then
  ln -s "$UV_TOOL_BIN_DIR/browser-use" "$shortcut"
fi
python3 "$DOTFILES_ROOT/src/retire-agent-browser-skill.py"
