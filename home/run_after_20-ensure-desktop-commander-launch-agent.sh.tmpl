#!/bin/sh
set -eu

{{ if eq .profile "personal" -}}
if [ "$(uname -s)" != Darwin ] || [ "${DOTFILES_SKIP_OPTIONAL_APPS:-}" = 1 ]; then
  exit 0
fi

label='com.arthur.desktop-commander-remote'
plist="$HOME/Library/LaunchAgents/$label.plist"
domain="gui/$(id -u)"
service="$domain/$label"
marker="$HOME/Library/Caches/chezmoi/$label.sha256"

# Never replace a working remote connection with a broken executable.
cli="$HOME/.local/bin/desktop-commander-remote"
if [ ! -x "$cli" ]; then
  echo "Desktop Commander executable unavailable: $cli (run the personal installer first)." >&2
  exit 1
fi

DOTFILES_ROOT={{ .chezmoi.workingTree | quote }}
if [ -r "$DOTFILES_ROOT/src/provisioning-log.sh" ]; then
  source "$DOTFILES_ROOT/src/provisioning-log.sh"
  dotfiles_section "BACKGROUND SERVICES"
fi
plutil -lint "$plist" >/dev/null
current_hash="$(shasum -a 256 "$plist" | awk '{print $1}')"
previous_hash="$(cat "$marker" 2>/dev/null || true)"

if launchctl print "$service" >/dev/null 2>&1; then
  # A missing marker means active configuration is unknown: reconcile it.
  if [ "$previous_hash" != "$current_hash" ]; then
    if [ "${DOTFILES_ALLOW_SERVICE_INTERRUPTION:-0}" != 1 ]; then
      echo "Desktop Commander LaunchAgent changed, but the running connection was preserved." >&2
      echo "Review the plist and explicitly set DOTFILES_ALLOW_SERVICE_INTERRUPTION=1 to restart it." >&2
      exit 0
    fi
    launchctl bootout "$domain" "$plist"
    launchctl bootstrap "$domain" "$plist"
  fi
else
  launchctl bootstrap "$domain" "$plist"
fi

mkdir -p "$(dirname "$marker")"
tmp_marker="$(mktemp "$marker.XXXXXX")"
printf '%s\n' "$current_hash" > "$tmp_marker"
mv "$tmp_marker" "$marker"
{{ else -}}
# Only remove a previously managed personal agent (marker proves ownership).
label='com.arthur.desktop-commander-remote'
plist="$HOME/Library/LaunchAgents/$label.plist"
marker="$HOME/Library/Caches/chezmoi/$label.sha256"
if [ -f "$marker" ]; then
  domain="gui/$(id -u)"
  if launchctl print "$domain/$label" >/dev/null 2>&1; then
    if [ "${DOTFILES_ALLOW_SERVICE_INTERRUPTION:-0}" != 1 ]; then
      echo "Desktop Commander agent belongs to the previous profile; leaving the running service intact." >&2
      echo "Set DOTFILES_ALLOW_SERVICE_INTERRUPTION=1 for an intentional profile migration." >&2
      exit 0
    fi
    launchctl bootout "$domain" "$plist"
  fi
  rm -f "$plist" "$marker"
fi
exit 0
{{ end -}}
