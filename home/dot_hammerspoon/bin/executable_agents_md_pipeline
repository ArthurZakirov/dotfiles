#!/usr/bin/env python3
"""Desktop entrypoint for the shared Codex AGENTS.md pipeline."""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--codex-home", type=Path)
    options, _ = parser.parse_known_args()
    codex_home = options.codex_home or Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()
    pipeline = codex_home / "hooks-json/agents-md-freshness/pipeline.py"
    if not pipeline.is_file():
        print(f"Shared Codex pipeline not installed: {pipeline}", file=sys.stderr)
        return 1
    return subprocess.call([sys.executable, str(pipeline), *sys.argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
