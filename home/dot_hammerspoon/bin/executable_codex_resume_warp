#!/usr/bin/env python3
"""Open one verified Codex Desktop thread in a new Warp tab."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import shlex
from pathlib import Path
import sqlite3
import subprocess
import sys
import time
import uuid


class LaunchError(Exception):
    """A new Codex terminal tab could not be requested safely."""


def validated_thread_id(value: str) -> str:
    try:
        result = str(uuid.UUID(value))
    except ValueError as exc:
        raise LaunchError("Invalid Codex thread ID") from exc
    if value.lower() != result:
        raise LaunchError("Codex thread ID must be a canonical UUID")
    return result


def session_directory(thread_id: str, home: Path) -> Path:
    database = home / ".codex/state_5.sqlite"
    if not database.is_file():
        raise LaunchError("Codex thread database not found")
    try:
        with sqlite3.connect(database.as_uri() + "?mode=ro", uri=True) as con:
            con.execute("PRAGMA query_only=ON")
            record = con.execute(
                "SELECT cwd FROM threads WHERE id = ?", (thread_id,)
            ).fetchone()
    except sqlite3.Error as exc:
        raise LaunchError("Codex thread database unavailable") from exc
    if not record or not isinstance(record[0], str):
        raise LaunchError("Codex thread ID not found in local history")
    directory = Path(record[0]).expanduser()
    if not directory.is_dir():
        raise LaunchError(f"Original Codex workspace no longer exists: {directory}")
    return directory.resolve()


def wait_for_unlocked(thread_id: str, home: Path, *, timeout: float = 45) -> None:
    """Wait for the Desktop's per-thread advisory lock before starting Codex."""
    lock = home / ".codex/thread-writer-locks" / f"{thread_id}.lock"
    deadline = time.monotonic() + timeout
    while True:
        try:
            with lock.open("r+b") as stream:
                try:
                    fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    pass
                else:
                    fcntl.flock(stream, fcntl.LOCK_UN)
                    return
        except FileNotFoundError:
            # A thread which is not currently open may not have a lock file.
            return
        except OSError as exc:
            raise LaunchError("Cannot inspect Codex session lock") from exc
        if time.monotonic() >= deadline:
            raise LaunchError("Codex Desktop did not release the session lock")
        time.sleep(0.2)


def resume_when_unlocked(
    thread_id: str, ready_file: Path, *, home: Path | None = None,
    executor=os.execvp, timeout: float = 45,
) -> None:
    """Run inside the newly opened Warp tab; signal readiness before waiting."""
    thread_id = validated_thread_id(thread_id)
    home = home or Path.home()
    folder = home / ".warp/tab_configs"
    if (ready_file.parent.resolve() != folder.resolve()
            or not ready_file.name.startswith("codex_desktop_resume_")
            or not ready_file.name.endswith(".ready")):
        raise LaunchError("Invalid Warp readiness path")
    try:
        fd = os.open(ready_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.close(fd)
    except OSError as exc:
        raise LaunchError("Cannot signal Warp tab readiness") from exc
    wait_for_unlocked(thread_id, home, timeout=timeout)
    try:
        executor("codex", ["codex", "resume", thread_id])
    except OSError as exc:
        raise LaunchError("Codex CLI could not start in Warp") from exc


def launch(
    thread_id: str, *, home: Path | None = None,
    runner=subprocess.run, ready_timeout: float = 15,
) -> Path:
    thread_id = validated_thread_id(thread_id)
    home = home or Path.home()
    directory = session_directory(thread_id, home)
    folder = home / ".warp/tab_configs"
    folder.mkdir(parents=True, exist_ok=True)
    # Reap only our own old one-shot tab configs and ready markers.
    for pattern in ("codex_desktop_resume_*.toml", "codex_desktop_resume_*.ready"):
        for item in folder.glob(pattern):
            try:
                if item.is_file() and item.stat().st_mtime < time.time() - 3600:
                    item.unlink()
            except OSError:
                pass

    name = "codex_desktop_resume_" + uuid.uuid4().hex
    target = folder / (name + ".toml")
    ready_file = folder / (name + ".ready")
    # Commands launch in Warp and acknowledge the actual tab, not just the URL.
    # The CLI starts only after the Desktop app releases this thread's lock.
    program = home / ".hammerspoon/bin/codex_resume_warp"
    command = " ".join(map(shlex.quote, (
        str(program), "--resume-when-unlocked", thread_id,
        "--ready-file", str(ready_file),
    )))
    contents = (
        f"name = {json.dumps('Codex ' + thread_id[:8])}\n"
        f"title = {json.dumps('Codex ' + thread_id[:8])}\n"
        "[[panes]]\n"
        'id = "main"\n'
        'type = "terminal"\n'
        f"directory = {json.dumps(str(directory), ensure_ascii=False)}\n"
        f"commands = [{json.dumps(command)}]\n"
    )
    try:
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(contents)
        result = runner(
            ["/usr/bin/open", f"warp://tab_config/{name}"],
            text=True, capture_output=True, timeout=15, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise LaunchError("Failed to request Warp tab") from exc
    if result.returncode != 0:
        raise LaunchError("Warp rejected the new tab request")
    deadline = time.monotonic() + ready_timeout
    while not ready_file.is_file():
        if time.monotonic() >= deadline:
            raise LaunchError("Warp did not start the session transfer command")
        time.sleep(0.1)
    ready_file.unlink(missing_ok=True)
    return target


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--session-id")
    mode.add_argument("--resume-when-unlocked")
    parser.add_argument("--ready-file", type=Path)
    args = parser.parse_args(argv)
    try:
        if args.session_id:
            launch(args.session_id)
            print("Warp session transfer started")
        else:
            if not args.ready_file:
                parser.error("--ready-file is required for --resume-when-unlocked")
            resume_when_unlocked(args.resume_when_unlocked, args.ready_file)
    except LaunchError as exc:
        print(f"codex-resume-warp: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
