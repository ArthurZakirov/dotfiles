#!/bin/sh
# Compile the microphone meter on first use; keep compiled artifacts out of Git.
set -eu

source_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source="$source_dir/mic_level.swift"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hammerspoon"
executable="$cache_dir/mic_level"

if [ ! -x "$executable" ] || [ "$source" -nt "$executable" ]; then
  if ! command -v swiftc >/dev/null 2>&1; then
    echo 'swiftc is required to build the Hammerspoon microphone meter.' >&2
    exit 127
  fi
  mkdir -p "$cache_dir"
  temporary=$(mktemp "$cache_dir/mic_level.XXXXXX")
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  swiftc "$source" -o "$temporary"
  chmod 700 "$temporary"
  mv -f "$temporary" "$executable"
  trap - EXIT HUP INT TERM
fi
exec "$executable"
